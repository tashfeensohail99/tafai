# =============================================================================
# Tashfeen AI Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values for your environment.
# NEVER commit .env with real credentials.

# =============================================================================
# APP
# =============================================================================
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE — Supabase Postgres with modular schemas
# =============================================================================
# Production project: fpnoyngotalmtxnhjldh (Seoul, ap-northeast-2)
# Schemas: core, audit, crm, processing, finance, ai, whatsapp, (sales, client_portal reserved)
#
# Use the SUPAVISOR POOLER URLs from Supabase Dashboard →
#   Project Settings → Database → Connection string → Transaction / Session
#
# Runtime: Transaction pooler (port 6543) — efficient for API queries.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
# Migrations: Session pooler (port 5432) — supports DDL, required by Prisma migrate.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# =============================================================================
# JWT / AUTH
# =============================================================================
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MINIMUM_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# S3-COMPATIBLE STORAGE (MinIO for local)
# =============================================================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio_access_key
STORAGE_SECRET_KEY=minio_secret_key
STORAGE_BUCKET=tafsheen-documents
STORAGE_REGION=us-east-1
STORAGE_SIGNED_URL_EXPIRES_SECONDS=300

# =============================================================================
# AI WORKER
# =============================================================================
AI_WORKER_URL=http://localhost:8000
AI_WORKER_API_KEY=CHANGE_THIS_AI_WORKER_INTERNAL_KEY

# =============================================================================
# WHATSAPP MODULE — Meta WhatsApp Business Cloud API
# Used by apps/backend/src/modules/whatsapp/
# Access tokens for each WABA channel are stored encrypted in the database
# (whatsapp.channels.accessTokenEnc); these env vars are app-level secrets.
# =============================================================================
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
# Token YOU choose, given to Meta when subscribing webhooks.
META_WEBHOOK_VERIFY_TOKEN=
# AES-256-GCM key for encrypting stored Meta access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_ENCRYPTION_KEY=
# Optional bucket for re-hosted inbound WhatsApp media. Defaults to the
# shared STORAGE_* config if left blank.
WHATSAPP_MEDIA_BUCKET=
WHATSAPP_MEDIA_PUBLIC_BASE_URL=

# =============================================================================
# REDIS (BullMQ + WebSocket pub/sub for the WhatsApp module)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# EMAIL / SMTP
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Tashfeen Immigration Solutions
SMTP_FROM_EMAIL=noreply@tashfeen.com

# =============================================================================
# THROTTLING / RATE LIMITS
# =============================================================================
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_SECONDS=300

# =============================================================================
# CORS
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=debug
