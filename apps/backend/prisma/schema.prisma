// =============================================================================
// PROCESSING MODULE — MODELS
// =============================================================================

model DocumentRequirementTemplate {
  id                 String               @id @default(uuid())
  service            String
  targetCountry      String
  documentName       String
  description        String?
  instructions       String?
  criticality        DocumentCriticality  @default(REQUIRED)
  conditionRule      Json?
  expectedFormats    String[]             @default(["PDF"])
  maxFileSizeMb      Int                  @default(10)
  validityRule       DocumentValidityRule @default(NONE)
  validityMonths     Int?
  validityBufferDays Int                  @default(30)
  guidanceUrl        String?
  sortOrder          Int                  @default(0)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  createdByUserId    String?

  createdBy         UserAccount?       @relation("DocTemplateCreatedBy", fields: [createdByUserId], references: [id])
  caseDocumentItems CaseDocumentItem[]

  @@index([service, targetCountry])
  @@index([isActive])
  @@map("document_requirement_templates")
  @@schema("processing")
}

model ProcessingCase {
  id                      String                 @id @default(uuid())
  financeHandoverId       String                 @unique
  leadId                  String
  // Per the platform rule "No ProcessingCase without Client" — every case is
  // owned by a Client. Lead→Client conversion happens automatically when
  // Finance sends the case to Processing; see ProcessingService.createFromHandover.
  clientId                String
  branchId                String?
  assignedOfficerId       String?
  priority                ProcessingCasePriority @default(NORMAL)
  stage                   ProcessingCaseStage    @default(INTAKE_PENDING)
  slaStatus               ProcessingSlaStatus    @default(ACTIVE)
  slaDueAt                DateTime?
  service                 String
  targetCountry           String
  financeHandoverNote     String?
  processingNote          String?
  estimatedSubmissionDate DateTime?              @db.Date
  actualSubmissionDate    DateTime?              @db.Date
  authorityTrackingRef    String?
  authorityDecision       AuthorityDecision      @default(PENDING)
  authorityDecisionDate   DateTime?              @db.Date
  completedAt             DateTime?
  cancelledAt             DateTime?
  cancellationReason      String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  createdByUserId         String
  updatedByUserId         String?

  financeHandover  FinanceHandover                @relation(fields: [financeHandoverId], references: [id])
  lead             Lead                           @relation(fields: [leadId], references: [id])
  client           Client                         @relation(fields: [clientId], references: [id])
  branch           Branch?                        @relation(fields: [branchId], references: [id])
  assignedOfficer  UserAccount?                   @relation("ProcessingCaseOfficer", fields: [assignedOfficerId], references: [id])
  createdBy        UserAccount                    @relation("ProcessingCaseCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy        UserAccount?                   @relation("ProcessingCaseUpdatedBy", fields: [updatedByUserId], references: [id])
  stageHistory        ProcessingCaseStageHistory[]
  documentItems       CaseDocumentItem[]
  correctionRequests  CorrectionRequest[]
  communications      CaseCommunication[]
  reminders           ClientReminder[]
  notes               ProcessingNote[]
  tasks               ProcessingTask[]
  submissions         AuthoritySubmission[]
  auditLogs           ProcessingAuditLog[]

  @@index([assignedOfficerId])
  @@index([stage])
  @@index([clientId])
  @@index([leadId])
  @@index([priority, stage])
  @@map("processing_cases")
  @@schema("processing")
}

model ProcessingCaseStageHistory {
  id              String               @id @default(uuid())
  caseId          String
  fromStage       ProcessingCaseStage?
  toStage         ProcessingCaseStage
  changedByUserId String
  reason          String?
  notes           String?
  gateCheckResult Json?
  createdAt       DateTime             @default(now())

  case      ProcessingCase @relation(fields: [caseId], references: [id])
  changedBy UserAccount    @relation("StageChangedBy", fields: [changedByUserId], references: [id])

  @@index([caseId])
  @@map("processing_case_stage_history")
  @@schema("processing")
}

model CaseDocumentItem {
  id                 String               @id @default(uuid())
  caseId             String
  templateId         String?
  documentName       String
  description        String?
  criticality        DocumentCriticality  @default(REQUIRED)
  expectedFormats    String[]             @default(["PDF"])
  maxFileSizeMb      Int                  @default(10)
  validityRule       DocumentValidityRule @default(NONE)
  validityMonths     Int?
  validityBufferDays Int                  @default(30)
  status             DocumentItemStatus   @default(NOT_SUBMITTED)
  latestVersionId    String?              @unique
  validityExpiryDate DateTime?            @db.Date
  expiryAlertSentAt  DateTime?
  lastRequestedAt    DateTime?
  requestDeadline    DateTime?            @db.Date
  waivedByUserId     String?
  waiveReason        String?
  sortOrder          Int                  @default(0)
  isAddedManually    Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  case               ProcessingCase                  @relation(fields: [caseId], references: [id])
  template           DocumentRequirementTemplate?    @relation(fields: [templateId], references: [id])
  waivedBy           UserAccount?                    @relation("DocItemWaivedBy", fields: [waivedByUserId], references: [id])
  latestVersion      ClientDocumentVersion?          @relation("LatestDocVersion", fields: [latestVersionId], references: [id])
  versions           ClientDocumentVersion[]         @relation("DocItemVersions")
  reviewDecisions    DocumentReviewDecision[]
  correctionRequests CorrectionRequest[]

  @@index([caseId])
  @@index([status, caseId])
  @@index([validityExpiryDate])
  @@map("case_document_items")
  @@schema("processing")
}

model ClientDocumentVersion {
  id               String          @id @default(uuid())
  documentItemId   String
  caseId           String
  clientId         String?
  storageKey       String
  fileName         String
  fileSizeBytes    Int?
  mimeType         String?
  versionNumber    Int
  uploadedAt       DateTime        @default(now())
  uploadedByUserId String?
  virusScanStatus  VirusScanStatus @default(PENDING)
  virusScanAt      DateTime?
  isCurrent        Boolean         @default(true)

  documentItem    CaseDocumentItem              @relation("DocItemVersions", fields: [documentItemId], references: [id])
  isLatestFor     CaseDocumentItem?             @relation("LatestDocVersion")
  uploadedBy      UserAccount?                  @relation("DocVersionUploadedBy", fields: [uploadedByUserId], references: [id])
  reviewDecisions DocumentReviewDecision[]
  accessLogs      DocumentAccessLog[]

  @@index([documentItemId])
  @@index([caseId])
  @@map("client_document_versions")
  @@schema("processing")
}

model DocumentReviewDecision {
  id                   String                @id @default(uuid())
  documentItemId       String
  versionId            String
  decision             DocReviewDecisionType
  rejectionReasonCodes String[]
  rejectionNote        String?
  reviewedByUserId     String
  createdAt            DateTime              @default(now())

  documentItem CaseDocumentItem      @relation(fields: [documentItemId], references: [id])
  version      ClientDocumentVersion @relation(fields: [versionId], references: [id])
  reviewedBy   UserAccount           @relation("DocReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([documentItemId])
  @@map("document_review_decisions")
  @@schema("processing")
}

model DocumentAccessLog {
  id                String        @id @default(uuid())
  documentVersionId String
  accessedByUserId  String
  accessType        DocAccessType
  ipAddress         String?
  userAgent         String?
  signedUrlIssuedAt DateTime      @default(now())
  createdAt         DateTime      @default(now())

  documentVersion ClientDocumentVersion @relation(fields: [documentVersionId], references: [id])
  accessedBy      UserAccount           @relation("DocAccessedBy", fields: [accessedByUserId], references: [id])

  @@index([documentVersionId])
  @@index([accessedByUserId])
  @@map("document_access_logs")
  @@schema("processing")
}

model CorrectionRequest {
  id                String                   @id @default(uuid())
  caseId            String
  documentItemId    String?
  raisedByOfficerId String
  correctionType    CorrectionType
  subject           String
  reasonCodes       String[]
  officerNote       String?
  clientMessage     String
  requiredAction    CorrectionRequiredAction
  slaHours          Int                      @default(120)
  slaDueAt          DateTime?
  status            CorrectionStatus         @default(SENT)
  resolvedAt        DateTime?
  resolvedByUserId  String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  case         ProcessingCase    @relation(fields: [caseId], references: [id])
  documentItem CaseDocumentItem? @relation(fields: [documentItemId], references: [id])
  raisedBy     UserAccount       @relation("CorrectionRaisedBy", fields: [raisedByOfficerId], references: [id])
  resolvedBy   UserAccount?      @relation("CorrectionResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([caseId])
  @@index([status])
  @@map("correction_requests")
  @@schema("processing")
}

model CaseCommunication {
  id                String                   @id @default(uuid())
  caseId            String
  direction         CommunicationDirection
  messageType       CommunicationMessageType
  subject           String?
  content           String
  channelsSent      String[]
  sentByUserId      String?
  readByClientAt    DateTime?
  whatsappMessageId String?
  emailMessageId    String?
  createdAt         DateTime                 @default(now())

  case   ProcessingCase @relation(fields: [caseId], references: [id])
  sentBy UserAccount?   @relation("CaseCommunicationSentBy", fields: [sentByUserId], references: [id])

  @@index([caseId, createdAt(sort: Desc)])
  @@map("case_communications")
  @@schema("processing")
}

model ClientReminder {
  id              String                 @id @default(uuid())
  caseId          String
  clientId        String?
  reminderType    ReminderType
  channel         ReminderChannel
  scheduledAt     DateTime
  sentAt          DateTime?
  deliveryStatus  ReminderDeliveryStatus @default(PENDING)
  templateId      String?
  renderedContent String?
  retryCount      Int                    @default(0)
  errorMessage    String?
  createdAt       DateTime               @default(now())

  case   ProcessingCase @relation(fields: [caseId], references: [id])
  client Client?        @relation(fields: [clientId], references: [id])

  @@index([caseId])
  @@index([scheduledAt])
  @@map("client_reminders")
  @@schema("crm")
}

model ProcessingNote {
  id              String             @id @default(uuid())
  caseId          String
  content         String
  noteType        ProcessingNoteType @default(GENERAL)
  isPinned        Boolean            @default(false)
  mentions        String[]
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  case      ProcessingCase @relation(fields: [caseId], references: [id])
  createdBy UserAccount    @relation("ProcessingNoteCreatedBy", fields: [createdByUserId], references: [id])

  @@index([caseId])
  @@map("processing_notes")
  @@schema("processing")
}

model ProcessingTask {
  id                String               @id @default(uuid())
  caseId            String
  title             String               @db.VarChar(120)
  description       String?
  assignedToUserId  String?
  createdByUserId   String
  dueDate           DateTime?            @db.Date
  priority          ProcessingTaskPriority @default(NORMAL)
  status            ProcessingTaskStatus @default(OPEN)
  completedAt       DateTime?
  completedByUserId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  case        ProcessingCase @relation(fields: [caseId], references: [id])
  assignedTo  UserAccount?   @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy   UserAccount    @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  completedBy UserAccount?   @relation("TaskCompletedBy", fields: [completedByUserId], references: [id])

  @@index([caseId])
  @@index([assignedToUserId, status])
  @@map("processing_tasks")
  @@schema("processing")
}

model AuthoritySubmission {
  id                  String                    @id @default(uuid())
  caseId              String
  submissionNumber    Int
  submittedByUserId   String
  submissionDate      DateTime                  @db.Date
  submissionReference String?
  authority           String
  documentsIncluded   String[]
  trackingNumber      String?
  status              AuthoritySubmissionStatus @default(SUBMITTED)
  responseReceivedAt  DateTime?
  responseType        AuthorityResponseType?
  responseNotes       String?
  nextAction          String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  case        ProcessingCase @relation(fields: [caseId], references: [id])
  submittedBy UserAccount    @relation("AuthoritySubmittedBy", fields: [submittedByUserId], references: [id])

  @@index([caseId])
  @@map("authority_submissions")
  @@schema("processing")
}

model ProcessingAuditLog {
  id          String   @id @default(uuid())
  caseId      String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  case  ProcessingCase? @relation(fields: [caseId], references: [id])
  actor UserAccount?    @relation("ProcessingAuditActor", fields: [actorUserId], references: [id])

  @@index([caseId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("processing_audit_logs")
  @@schema("processing")
}

// =============================================================================
// WHATSAPP MODULE
// Lives in the dedicated `whatsapp` schema for isolation from the immigration
// CRM core. Linked to public.leads and public.clients via foreign keys.
// =============================================================================

enum WhatsAppChannelTier {
  TIER_1K
  TIER_10K
  TIER_100K
  TIER_UNLIMITED
  @@schema("whatsapp")
}

enum WhatsAppChannelStatus {
  ACTIVE
  PAUSED
  REVOKED
  @@schema("whatsapp")
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
  @@schema("whatsapp")
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS
  INTERACTIVE
  TEMPLATE
  REACTION
  SYSTEM
  UNSUPPORTED
  @@schema("whatsapp")
}

enum WhatsAppMessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
  @@schema("whatsapp")
}

enum WhatsAppThreadStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
  @@schema("whatsapp")
}

enum WhatsAppAssignmentReason {
  STICKY
  ROUND_ROBIN
  MANUAL
  REASSIGN
  TAKEOVER
  UNASSIGN
  AUTO_RESOLVE
  @@schema("whatsapp")
}

enum WhatsAppTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
  @@schema("whatsapp")
}

enum WhatsAppTemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
  @@schema("whatsapp")
}

enum WhatsAppCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  PAUSED
  CANCELLED
  FAILED
  @@schema("whatsapp")
}

// One row per WABA phone number. Tashfeen runs a single channel today; the
// schema supports more (per-branch, per-product).
model WhatsAppChannel {
  id              String                @id @default(uuid())
  label           String
  wabaId          String
  phoneNumberId   String                @unique
  displayNumber   String
  // AES-256-GCM ciphertext of the access token. Format: iv:ciphertext:tag (base64).
  accessTokenEnc  String
  // Optional per-channel webhook verify token (overrides org default).
  webhookVerifyToken String?
  tier            WhatsAppChannelTier   @default(TIER_1K)
  status          WhatsAppChannelStatus @default(ACTIVE)
  lastSyncAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  threads   WhatsAppThread[]
  messages  WhatsAppMessage[]
  templates WhatsAppTemplate[]
  campaigns WhatsAppCampaign[]

  @@index([status])
  @@map("channels")
  @@schema("whatsapp")
}

// One thread per (channel, contact) tuple. Lead-rooted while in sales pipeline;
// re-rooted onto Client after `POST /leads/:id/convert` runs.
model WhatsAppThread {
  id                String   @id @default(uuid())
  channelId         String
  // The thread belongs to a Lead until conversion, then a Client. Always one
  // of these two is non-null; both may be set during conversion.
  leadId            String?  @unique
  clientId          String?
  // WhatsApp's wa_id (E.164 without leading +). Indexed for fast inbound lookup.
  waContactId       String
  // 24-hour customer-service window. Outbound outside this window MUST be a
  // template message. Set/refreshed on every inbound.
  windowExpiresAt   DateTime?
  status            WhatsAppThreadStatus @default(OPEN)
  // --- SLA tracking ---
  firstInboundAt    DateTime?
  firstAgentReplyAt DateTime?
  slaDeadlineAt     DateTime?
  slaBreached       Boolean  @default(false)
  // --- Denormalized for inbox list ordering ---
  lastMessageAt     DateTime?
  lastMessagePreview String?
  unreadCount       Int      @default(0)
  // Why the current assignment was made (sticky / round-robin / manual).
  lastAssignmentReason WhatsAppAssignmentReason?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  channel  WhatsAppChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lead     Lead?              @relation("LeadWhatsAppThread", fields: [leadId], references: [id], onDelete: SetNull)
  client   Client?            @relation("ClientWhatsAppThreads", fields: [clientId], references: [id], onDelete: SetNull)
  messages WhatsAppMessage[]

  @@unique([channelId, waContactId])
  @@index([leadId])
  @@index([clientId])
  @@index([status, lastMessageAt(sort: Desc)])
  @@index([slaDeadlineAt])
  @@map("threads")
  @@schema("whatsapp")
}

// Every inbound + outbound message.
model WhatsAppMessage {
  id                 String   @id @default(uuid())
  threadId           String
  channelId          String
  // Denormalized lead/client foreign keys for fast filtering without joining
  // through thread. Kept in sync by the worker.
  leadId             String?
  clientId           String?
  // Meta's wa_message_id (wamid.xxx). Unique per channel. NULL until accepted.
  waMessageId        String?  @unique
  // Idempotency key generated on outbound enqueue. Prevents double-send.
  idempotencyKey     String?  @unique

  direction          WhatsAppMessageDirection
  type               WhatsAppMessageType
  status             WhatsAppMessageStatus @default(QUEUED)

  body               String?
  payload            Json?
  mediaUrl           String?
  mediaMimeType      String?
  mediaSizeBytes     Int?
  mediaSha256        String?

  templateName       String?
  templateLanguage   String?

  // Employee who hit send (NULL for system/campaign/inbound).
  sentByEmployeeId   String?
  campaignId         String?
  pricingCategory    String?

  errorCode          String?
  errorTitle         String?
  errorDetails       Json?

  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?

  // For inbound replies that quote another message.
  repliedToWaMessageId String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  thread         WhatsAppThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  channel        WhatsAppChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lead           Lead?             @relation("LeadWhatsAppMessages", fields: [leadId], references: [id], onDelete: SetNull)
  client         Client?           @relation("ClientWhatsAppMessages", fields: [clientId], references: [id], onDelete: SetNull)
  sentByEmployee Employee?         @relation("WhatsAppMessageSentBy", fields: [sentByEmployeeId], references: [id], onDelete: SetNull)
  campaign       WhatsAppCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt(sort: Desc)])
  @@index([direction, status])
  @@index([campaignId])
  @@index([createdAt(sort: Desc)])
  @@map("messages")
  @@schema("whatsapp")
}

// Mirror of Meta's approved templates per WABA. Required to send outbound
// messages outside the 24-hour window.
model WhatsAppTemplate {
  id              String                  @id @default(uuid())
  channelId       String
  name            String
  language        String
  category        WhatsAppTemplateCategory
  status          WhatsAppTemplateStatus
  components      Json
  qualityRating   String?
  rejectedReason  String?
  lastSyncAt      DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  channel   WhatsAppChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  campaigns WhatsAppCampaign[]

  @@unique([channelId, name, language])
  @@index([status])
  @@map("templates")
  @@schema("whatsapp")
}

// Template broadcast to a list of contacts (Phase 4 feature).
model WhatsAppCampaign {
  id              String                 @id @default(uuid())
  channelId       String
  templateId      String
  createdByUserId String

  name            String
  description     String?
  variableMap     Json                   @default("{}")
  scheduledFor    DateTime?
  status          WhatsAppCampaignStatus @default(DRAFT)

  totalAudience   Int                    @default(0)
  totalQueued     Int                    @default(0)
  totalSent       Int                    @default(0)
  totalDelivered  Int                    @default(0)
  totalRead       Int                    @default(0)
  totalFailed     Int                    @default(0)

  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  channel  WhatsAppChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  template WhatsAppTemplate  @relation(fields: [templateId], references: [id])
  messages WhatsAppMessage[]

  @@index([status])
  @@index([scheduledFor])
  @@map("campaigns")
  @@schema("whatsapp")
}

// Customers who have opted out of WhatsApp marketing. Honored on every send.
model WhatsAppOptOut {
  id        String   @id @default(uuid())
  waId      String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@map("opt_outs")
  @@schema("whatsapp")
}

// Raw webhook payload log. Kept for forensics + replay. Older entries are
// pruned by a scheduled cleanup job.
model WhatsAppWebhookEvent {
  id              String   @id @default(uuid())
  signature       String
  signatureValid  Boolean
  objectType      String?
  rawPayload      Json
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([processedAt])
  @@map("webhook_events")
  @@schema("whatsapp")
}
