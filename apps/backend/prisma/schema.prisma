  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  DEPARTMENT_DELETED
  // Branches
  BRANCH_CREATED
  BRANCH_UPDATED
  BRANCH_DELETED
  // Leads
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_ASSIGNED
  LEAD_REASSIGNED
  LEAD_CONVERTED
  LEAD_LOST
  LEAD_DUPLICATE_MARKED
  FOLLOW_UP_CREATED
  FOLLOW_UP_UPDATED
  FOLLOW_UP_COMPLETED
  FINANCE_HANDOVER_CREATED
  FINANCE_HANDOVER_UPDATED
  FINANCE_HANDOVER_REVIEWED
  // Clients & cases
