}

// =============================================================================
// WHATSAPP MODULE
// Lives in the dedicated `whatsapp` schema for isolation from the immigration
// CRM core. Linked to public.leads and public.clients via foreign keys.
// =============================================================================

enum WhatsAppChannelTier {
  TIER_1K
  TIER_10K
  TIER_100K
  TIER_UNLIMITED
  @@schema("whatsapp")
}

enum WhatsAppChannelStatus {
  ACTIVE
  PAUSED
  REVOKED
  @@schema("whatsapp")
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
  @@schema("whatsapp")
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS
  INTERACTIVE
  TEMPLATE
  REACTION
  SYSTEM
  UNSUPPORTED
  @@schema("whatsapp")
}

enum WhatsAppMessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
  @@schema("whatsapp")
}

enum WhatsAppThreadStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
  @@schema("whatsapp")
}

enum WhatsAppAssignmentReason {
  STICKY
  ROUND_ROBIN
  MANUAL
  REASSIGN
  TAKEOVER
  UNASSIGN
  AUTO_RESOLVE
  @@schema("whatsapp")
}

enum WhatsAppTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
  @@schema("whatsapp")
}

enum WhatsAppTemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
  @@schema("whatsapp")
}

enum WhatsAppCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  PAUSED
  CANCELLED
  FAILED
  @@schema("whatsapp")
}

// One row per WABA phone number. Tashfeen runs a single channel today; the
// schema supports more (per-branch, per-product).
model WhatsAppChannel {
  id              String                @id @default(uuid())
  label           String
  wabaId          String
  phoneNumberId   String                @unique
  displayNumber   String
  // AES-256-GCM ciphertext of the access token. Format: iv:ciphertext:tag (base64).
  accessTokenEnc  String
  // Optional per-channel webhook verify token (overrides org default).
  webhookVerifyToken String?
  tier            WhatsAppChannelTier   @default(TIER_1K)
  status          WhatsAppChannelStatus @default(ACTIVE)
  lastSyncAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  threads   WhatsAppThread[]
  messages  WhatsAppMessage[]
  templates WhatsAppTemplate[]
  campaigns WhatsAppCampaign[]

  @@index([status])
  @@map("channels")
  @@schema("whatsapp")
}

/// Inbound (and later outbound) WhatsApp voice calls. Scalar FKs only — the
/// DB-level foreign keys are added in the migration, so no Prisma back-relations
/// are needed on Thread/Channel/Lead/Client/Employee.
model WhatsAppCall {
  id                 String    @id @default(uuid())
  threadId           String?
  channelId          String
  leadId             String?
  clientId           String?
  assignedEmployeeId String?
  waCallId           String    @unique
  direction          String    @default("INBOUND")
  // RINGING | ANSWERED | ENDED | MISSED | FAILED — plain string for flexibility.
  status             String    @default("RINGING")
  // Last Meta call event seen: connect | ringing | terminate.
  event              String?
  startedAt          DateTime?
  endedAt            DateTime?
  durationSeconds    Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([assignedEmployeeId, createdAt(sort: Desc)])
  @@index([leadId])
  @@index([clientId])
  @@index([threadId])
  @@map("calls")
  @@schema("whatsapp")
}

// One thread per (channel, contact) tuple. Lead-rooted while in sales pipeline;
// re-rooted onto Client after `POST /leads/:id/convert` runs.
model WhatsAppThread {
  id                String   @id @default(uuid())
  channelId         String
  // The thread belongs to a Lead until conversion, then a Client. Always one
  // of these two is non-null; both may be set during conversion.
  leadId            String?  @unique
  clientId          String?
  // WhatsApp's wa_id (E.164 without leading +). Indexed for fast inbound lookup.
  waContactId       String
  // 24-hour customer-service window. Outbound outside this window MUST be a
  // template message. Set/refreshed on every inbound.
  windowExpiresAt   DateTime?
  status            WhatsAppThreadStatus @default(OPEN)
  // --- SLA tracking (legacy first-response) ---
  firstInboundAt    DateTime?
  firstAgentReplyAt DateTime?
  slaDeadlineAt     DateTime?
  slaBreached       Boolean  @default(false)

  // --- Rolling Response-SLA (pause-on-customer) ---
  // responseDeadlineAt is set whenever it becomes the agent's turn (a customer
  // message arrives with no pending reply) and cleared when the agent replies.
  // NULL = it's the customer's turn / resolved → no clock runs against the agent.
  responseDeadlineAt  DateTime?
  // When the current unanswered customer message arrived (the inbound that
  // started this clock). Used for "waiting Xm" displays.
  responseDueSince    DateTime?
  // Sweeper bookkeeping for the CURRENT pending window so we don't double-fire:
  responseWarned      Boolean  @default(false) // approaching-breach warning sent
  responseBreached    Boolean  @default(false) // breach already counted
  // Auto-acknowledgement: stamped once so we never double-send the greeting.
  autoAckSentAt       DateTime?
  // --- Denormalized for inbox list ordering ---
  lastMessageAt     DateTime?
  lastMessagePreview String?
  unreadCount       Int      @default(0)
  // Why the current assignment was made (sticky / round-robin / manual).
  lastAssignmentReason WhatsAppAssignmentReason?

  // --- Click-to-WhatsApp ad attribution ---
  // Populated when an inbound message arrives with a Meta `referral` block —
  // i.e. the customer started the conversation by clicking a Facebook /
  // Instagram WhatsApp ad. Meta only sends `referral` on the first message
  // after the click, so we stamp it here on the thread so it stays
  // surfaced in the inbox UI even on subsequent replies. If the same
  // contact clicks a different ad later we overwrite — adReferralAt is
  // always "the most recent ad they engaged via".
  adReferral         Json?
  adReferralAt       DateTime?

  // --- AI bot per-chat state -----------------------------------------------
  // Whether the AI assistant is allowed to compose replies on this thread.
  // Hard off — a human can flip this from the chat panel to permanently
  // disable AI on a chat ("I'll take this one"). Default ON.
  aiEnabled         Boolean  @default(true)
  // Stamped whenever ANY human agent sends an outbound message. The AI
  // orchestrator silences itself for 4 hours from this timestamp so the bot
  // can't talk over a live sales conversation. Auto-rolls forward on each
  // new human send. NULL = AI is free to fire.
  aiDisabledAt      DateTime?
  // Conversation phase tracker so the bot's appointment funnel persists
  // across messages. INITIAL → Q_AND_A → APPOINTMENT_PROPOSED →
  // APPOINTMENT_AVAILABILITY → HANDED_OFF. Updated by the orchestrator on
  // each turn so the next turn knows where we are in the funnel.
  aiState           String   @default("INITIAL")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  channel  WhatsAppChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lead     Lead?              @relation("LeadWhatsAppThread", fields: [leadId], references: [id], onDelete: SetNull)
  client   Client?            @relation("ClientWhatsAppThreads", fields: [clientId], references: [id], onDelete: SetNull)
  messages WhatsAppMessage[]

  @@unique([channelId, waContactId])
  @@index([leadId])
  @@index([clientId])
  @@index([status, lastMessageAt(sort: Desc)])
  @@index([slaDeadlineAt])
  // Default "ALL" inbox tab orders by lastMessageAt with no status filter,
  // so the [status, lastMessageAt] composite can't serve the sort — this
  // standalone index does.
  @@index([lastMessageAt(sort: Desc)])
  // Stats endpoint counts responseDeadlineAt three ways (set / overdue /
  // approaching) on every load, and the inbox "Pending" tab filters on it.
  @@index([responseDeadlineAt])
  // Unread counter feeds the stats "unread" count and the inbox badge filter.
  @@index([unreadCount])
  @@map("threads")
  @@schema("whatsapp")
}

// Every inbound + outbound message.
model WhatsAppMessage {
  id                 String   @id @default(uuid())
  threadId           String
  channelId          String
  // Denormalized lead/client foreign keys for fast filtering without joining
  // through thread. Kept in sync by the worker.
  leadId             String?
  clientId           String?
  // Meta's wa_message_id (wamid.xxx). Unique per channel. NULL until accepted.
  waMessageId        String?  @unique
  // Idempotency key generated on outbound enqueue. Prevents double-send.
  idempotencyKey     String?  @unique

  direction          WhatsAppMessageDirection
  type               WhatsAppMessageType
  status             WhatsAppMessageStatus @default(QUEUED)

  body               String?
  payload            Json?
  mediaUrl           String?
  mediaMimeType      String?
  mediaSizeBytes     Int?
  mediaSha256        String?

  templateName       String?
  templateLanguage   String?

  // Employee who hit send (NULL for system/campaign/inbound).
  sentByEmployeeId   String?
  campaignId         String?
  pricingCategory    String?

  errorCode          String?
  errorTitle         String?
  errorDetails       Json?

  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?

  // For inbound replies that quote another message.
  repliedToWaMessageId String?

  // Click-to-WhatsApp ad referral as sent by Meta on this specific message.
  // Stored per-message because the same thread can see multiple ad clicks
  // over its lifetime; the thread row carries the LATEST one for header
  // display, this column lets us look up which exact reply was triggered
  // by which ad. JSON shape matches Meta's `referral` object verbatim.
  adReferral         Json?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  thread         WhatsAppThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  channel        WhatsAppChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lead           Lead?             @relation("LeadWhatsAppMessages", fields: [leadId], references: [id], onDelete: SetNull)
  client         Client?           @relation("ClientWhatsAppMessages", fields: [clientId], references: [id], onDelete: SetNull)
  sentByEmployee Employee?         @relation("WhatsAppMessageSentBy", fields: [sentByEmployeeId], references: [id], onDelete: SetNull)
  campaign       WhatsAppCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt(sort: Desc)])
  @@index([direction, status])
  @@index([campaignId])
  @@index([createdAt(sort: Desc)])
  @@map("messages")
  @@schema("whatsapp")
}

// Mirror of Meta's approved templates per WABA. Required to send outbound
// messages outside the 24-hour window.
model WhatsAppTemplate {
  id              String                  @id @default(uuid())
  channelId       String
  name            String
  language        String
  category        WhatsAppTemplateCategory
  status          WhatsAppTemplateStatus
  components      Json
  qualityRating   String?
  rejectedReason  String?
  lastSyncAt      DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  channel   WhatsAppChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  campaigns WhatsAppCampaign[]

  @@unique([channelId, name, language])
  @@index([status])
  @@map("templates")
  @@schema("whatsapp")
}

// Template broadcast to a list of contacts (Phase 4 feature).
model WhatsAppCampaign {
  id              String                 @id @default(uuid())
  channelId       String
  templateId      String
  createdByUserId String

  name            String
  description     String?
  variableMap     Json                   @default("{}")
  scheduledFor    DateTime?
  status          WhatsAppCampaignStatus @default(DRAFT)

  totalAudience   Int                    @default(0)
  totalQueued     Int                    @default(0)
  totalSent       Int                    @default(0)
  totalDelivered  Int                    @default(0)
  totalRead       Int                    @default(0)
  totalFailed     Int                    @default(0)

  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  channel  WhatsAppChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  template WhatsAppTemplate  @relation(fields: [templateId], references: [id])
  messages WhatsAppMessage[]

  @@index([status])
  @@index([scheduledFor])
  @@map("campaigns")
  @@schema("whatsapp")
}

// Customers who have opted out of WhatsApp marketing. Honored on every send.
model WhatsAppOptOut {
  id        String   @id @default(uuid())
  waId      String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@map("opt_outs")
  @@schema("whatsapp")
}

// Raw webhook payload log. Kept for forensics + replay. Older entries are
// pruned by a scheduled cleanup job.
model WhatsAppWebhookEvent {
  id              String   @id @default(uuid())
  signature       String
  signatureValid  Boolean
  objectType      String?
  rawPayload      Json
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([processedAt])
  @@map("webhook_events")
  @@schema("whatsapp")
}

// =============================================================================
// AI / WhatsApp bot — pgvector knowledge base + suggestion + run log
// =============================================================================

/// One indexed unit of knowledge for the RAG bot. A row can be a Q&A pair
/// (from the XLSX files) or a brochure chunk (~500 chars). `embedding` is a
/// 1536-dim vector from OpenAI text-embedding-3-small — Prisma can't model
/// vector types natively so we declare it `Unsupported` and access it via
/// raw queries (see ai-knowledge.repository.ts).
model AiKnowledge {
  id          String                       @id @default(uuid())
  type        String                       // 'qa' | 'brochure_chunk' | 'company_profile'
  programKey  String?
  queryEn     String?
  queryUr     String?
  answerEn    String
  answerUr    String?
  sourceFile  String
  chunkIndex  Int?
  embedding   Unsupported("vector(1536)")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([programKey])
  @@map("knowledge")
  @@schema("ai")
}

/// AI-composed reply waiting for a human to send (SHADOW mode). When sales
/// hits "Use this", we transition to USED and dispatch via the existing send
/// pipeline. EDITED + REJECTED are training signal.
model AiSuggestion {
  id                  String   @id @default(uuid())
  threadId            String
  inboundMessageId    String
  suggestedReply      String
  language            String                                // 'en' | 'ur_roman' | 'ur' | 'other'
  topMatchType        String?
  topMatchSourceFile  String?
  topMatchSimilarity  Float?
  retrievedDocIds     String[]
  status              String   @default("PENDING")          // PENDING | USED | EDITED | REJECTED | EXPIRED
  usedByUserId        String?
  usedAt              DateTime?
  model               String
  inputTokens         Int?
  outputTokens        Int?
  latencyMs           Int?
  createdAt           DateTime @default(now())

  @@index([threadId, createdAt(sort: Desc)])
  @@index([status])
  @@map("suggestions")
  @@schema("ai")
}

/// One row per inbound message the bot processed. Powers the cost dashboard
/// + audit trail + "why didn't it reply?" forensics. Mode tells you whether
/// we sent automatically, queued a suggestion, or skipped (with reason).
model AiRun {
  id                  String   @id @default(uuid())
  threadId            String
  inboundMessageId    String   @unique
  mode                String                                // AUTO | SHADOW | SKIPPED
  skipReason          String?
  language            String?
  model               String?
  inputTokens         Int?
  outputTokens        Int?
  totalLatencyMs      Int?
  topMatchSimilarity  Float?
  outboundMessageId   String?
  suggestionId        String?
  error               String?
  createdAt           DateTime @default(now())

  @@index([threadId, createdAt(sort: Desc)])
  @@index([mode, createdAt(sort: Desc)])
  @@map("runs")
  @@schema("ai")
}

/// Bot-captured appointment intent. When the AI funnel reaches HANDED_OFF
/// state (customer said "Monday morning works"), the orchestrator extracts
/// structured intent and writes a row here. Sales picks up the row from the
/// chat panel banner, clicks Book Appointment, the modal pre-fills with the
/// captured preference, and on save we link `linkedAppointmentId` back to the
/// confirmed Appointment row.
///
/// Stays as a separate model (not an enum on Appointment) because:
///  - It represents PROVISIONAL intent — not a slot, not assigned, not
///    confirmed. Mixing it into Appointment would pollute the calendar/ICS
///    feed with proposals that may never happen.
///  - The bot can rewrite its own intent row across turns (the customer
///    sometimes negotiates the time), without churning real Appointment rows.
model AppointmentRequest {
  id                String   @id @default(uuid())
  leadId            String
  threadId          String?
  /// The WhatsApp message we extracted the intent from — for forensics +
  /// "scroll to this message" UX on the chat panel.
  extractedFromMessageId String?
  /// Free-text customer wording — kept verbatim so sales sees exactly what
  /// they said even if our parser missed nuance.
  rawText           String
  /// Parsed day-of-week (Monday / Tuesday / …) OR a date string (2026-06-03)
  /// OR null when unspecified.
  preferredDay      String?
  /// Parsed time slot (morning / afternoon / evening) OR a specific time
  /// (15:00) OR null when unspecified.
  preferredTime     String?
  /// Bot-detected modality.
  modality          String?  // CALL | VIDEO | IN_PERSON | UNKNOWN
  status            String   @default("PENDING") // PENDING | CONFIRMED | REJECTED | EXPIRED
  linkedAppointmentId String?  // set when sales books a real Appointment from this
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  closedAt          DateTime?
  closedByUserId    String?

  @@index([leadId, status, createdAt(sort: Desc)])
  @@index([threadId, status])
  @@map("appointment_requests")
  @@schema("crm")
}

/// PDF brochures the WhatsApp AI bot can attach to a reply. One row per
/// program (C11, ICT, SUV, EB2-NIW, RCIP, LMIA, JR, E2, VISIT) plus the
/// company profile. The file itself lives in S3 / Supabase storage; this
/// row carries the storage key, the customer-facing filename, and the
/// program identifier the bot pattern-matches on when a customer asks
/// "send me the brochure".
model BotBrochure {
  id            String   @id @default(uuid())
  /// Stable key matching the AiKnowledge.programKey values + the special
  /// 'COMPANY_PROFILE' for the about-us doc.
  programKey    String   @unique
  /// Human-readable title used as the WhatsApp filename when sending,
  /// e.g. "Canada C11 Work Permit — Tashfeen Immigration Solutions.pdf".
  displayTitle  String
  s3Key         String   /// storage key inside our bucket
  mimeType      String   @default("application/pdf")
  sizeBytes     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([programKey])
  @@map("brochures")
  @@schema("ai")
}

/// In-app notifications shown in the bell badge on the employee shell.
/// One row per (user, event) — e.g. "AI booked an appointment with John
/// Doe for Monday 10am". Marked read on click; bulk-marked on "Mark all
/// read". Kept in core schema because notifications are user-scoped, not
/// lead/customer-scoped.
///
/// Designed for low write volume (1-3 per agent per day at the bot's
/// scale) so we don't bother with an SQS-style fan-out; just direct
/// Prisma inserts from the producing service.
model Notification {
  id          String   @id @default(uuid())
  userId      String   // recipient
  /// Stable category for filtering / icon selection on the frontend.
  /// Today: APPOINTMENT_BOOKED. Add more as more producers come online.
  type        String
  title       String   // shown in the dropdown as the headline
  body        String?  // optional second line
  /// Path to navigate to when the notification is clicked (e.g.
  /// "/sales/appointments?focusId=…"). Relative to the app root.
  link        String?
  read        Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  user UserAccount @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
  @@schema("core")
}
