// =============================================================================
// ORGANIZATION
// =============================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  legalName String?
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- WhatsApp routing + SLA configuration --------------------------------
  // IANA timezone for business-hours math. Tashfeen defaults to Asia/Karachi.
  timezone                String  @default("Asia/Karachi")
  // Local-time business-hours window (24h "HH:MM").
  hoursOpen               String  @default("09:00")
  hoursClose              String  @default("18:00")
  // Optional mid-day break (24h "HH:MM"). The SLA clock PAUSES during this
  // window and resumes at breakEnd — same way it pauses overnight. Null/empty
  // = no break. Tashfeen: 12:30–14:00 lunch.
  breakStart              String? @default("12:30")
  breakEnd                String? @default("14:00")
  // Days of the week the team works. 0 = Sunday .. 6 = Saturday.
  // Tashfeen: Mon–Fri (Sat + Sun off).
  workingDays             Int[]   @default([1, 2, 3, 4, 5])
  // First-response SLA target in seconds (legacy; kept for back-compat).
  slaFirstResponseSeconds Int     @default(60)
  // Unified Response-SLA target in seconds — applies to EVERY customer message
  // awaiting an agent reply (first + all follow-ups). The clock only runs while
  // it's the agent's turn (pause-on-customer). Tashfeen: 300s = 5 minutes.
  slaResponseSeconds      Int     @default(300)
  // How many minutes before the deadline the "approaching breach" warning
  // fires (sweeper). Default: warn when 1 minute remains.
  slaWarnBeforeSeconds    Int     @default(60)
  // Deterrent threshold shown in the breach warning copy ("leads are
  // reassigned after N SLA breaches"). We count breaches but do NOT auto-
  // reassign yet — flipping that on later is a one-line change.
  slaReassignThreshold    Int     @default(10)
  // Reward: when a lead is matured + sent to finance, the sales agent who
  // owned it banks this many on-time "wins" — repairing their SLA score for
  // past slow replies. Closing deals literally improves your standing.
  slaHandoverBonus        Int     @default(5)
  // Maker-checker (segregation of duties): a payment at or above this amount
  // must be VERIFIED by a different finance officer than the one who recorded
  // it. 0 disables the control. Default 100,000.
  makerCheckerThreshold   Decimal @default(100000) @db.Decimal(12, 2)
  // Sales-tax / VAT / GST rate applied to invoices, as a percentage. 0 = the
  // firm doesn't charge tax (default). When > 0, invoices compute tax on the
  // net and show it as a separate line.
  taxRatePercent          Decimal @default(0) @db.Decimal(5, 2)
  // Period lock (book close): payments/invoices effective-dated before this
  // instant are rejected, so a closed accounting period can't be altered.
  // NULL = no lock (default).
  booksLockedBefore       DateTime?
  // Auto-acknowledgement: instant personalised reply when a lead first
  // messages. Does NOT satisfy the SLA — the agent must still reply. The
  // template supports {firstName}, {agentName}, {businessName} placeholders.
  // DISABLED by default per ops decision — flip to true (or set the column
  // true on the org row) to re-enable; the feature code stays in place.
  autoAckEnabled          Boolean @default(false)
  autoAckTemplate         String? @default("Hey {firstName}! 🌟 I'm {agentName} from {businessName} — you're in good hands. I've got your message and I'm right with you, give me just a moment! ✨")
  // Strict round-robin cursor — last Employee id picked. Engine selects the
  // next eligible employee with id > cursor (wrapping). Null = no cursor yet.
  rrCursorEmployeeId      String?
  // Approved template to auto-send to leads who message outside business hours.
  afterHoursTemplate      String?
  afterHoursTemplateLang  String? @default("en")

  // --- AI WhatsApp bot ------------------------------------------------------
  // When set, the AI orchestrator only fires for messages received AFTER this
  // moment. Lets ops flip the bot on for a future Monday (e.g. 2026-06-01) so
  // we can ingest data + smoke-test the admin UI before any client sees a
  // robotic reply. Null disables the bot entirely.
  botEnabledAt            DateTime?
  // Mode override. When AUTO (default): obeys the auto/shadow split based on
  // business hours + active-agent presence. When SHADOW_ONLY: never sends
  // automatically, only writes AI suggestions for human use. When DISABLED:
  // bot is off regardless of botEnabledAt.
  botMode                 String @default("AUTO")

  branches    Branch[]
  departments Department[]
  partners    Partner[]
  apiKeys     ApiKey[]

  @@map("organizations")
  @@schema("core")
}

/// Encrypted third-party API keys (OpenAI, future providers) managed via the
/// admin "API Keys" tab. Single source of truth — consumers fetch the active
/// key for their provider at call time so rotation just works. Plaintext key
/// is **never** stored: `keyEnc` holds AES-256-GCM ciphertext using the
/// existing WHATSAPP_ENCRYPTION_KEY env. `keyTail` keeps the last 4 chars in
/// plain text so the admin UI can render a masked preview without having to
/// decrypt.
model ApiKey {
  id              String   @id @default(uuid())
  organizationId  String
  provider        String   // 'openai' | (future: 'anthropic' | 'gemini' | …)
  label           String   // human-friendly name e.g. "Production OpenAI"
  keyEnc          String   // AES-256-GCM ciphertext of the secret
  keyTail         String   // last 4 chars for "sk-…AbCd" UI preview
  isActive        Boolean  @default(true)
  lastUsedAt      DateTime?
  lastTestedAt    DateTime?
  lastTestOk      Boolean?
  lastTestError   String?
  createdAt       DateTime @default(now())
  createdByUserId String?
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider, label])
  @@index([organizationId, provider, isActive])
  @@map("api_keys")
  @@schema("core")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  city           String?
  country        String?
  phone          String?
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  employees       Employee[]
  leads           Lead[]
  clients         Client[]
  partners        Partner[]
  processingCases ProcessingCase[]

  @@index([organizationId])
  @@map("branches")
  @@schema("core")
}

model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("services")
  @@schema("core")
}

model Country {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  isoCode     String?  @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("countries")
  @@schema("core")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]
  cases        Case[]

  @@index([organizationId])
  @@map("departments")
  @@schema("core")
}

model Designation {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("designations")
  @@schema("core")
}

// =============================================================================
// USERS, ROLES, PERMISSIONS
// =============================================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
  @@schema("core")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
  @@schema("core")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@schema("core")
}

model UserAccount {
  id                      String     @id @default(uuid())
  email                   String     @unique
  phone                   String?    @unique
  passwordHash            String
  status                  UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  failedLoginAttempts     Int        @default(0)
  lockedUntil             DateTime?
  passwordChangedAt       DateTime?
  mustChangePassword      Boolean    @default(false)
  twoFactorEnabled        Boolean    @default(false)
  twoFactorSecret         String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  deletedAt               DateTime?

  userRoles         UserRole[]
  loginSessions     LoginSession[]
  passwordResets    PasswordResetToken[]
  employee          Employee?
  partnerProfile    Partner?
  notifications     Notification[]       @relation("UserNotifications")
  auditActorLogs    AuditLog[]           @relation("AuditActor")
  createdLeads      Lead[]               @relation("LeadCreatedBy")
  uploadedLeadImportBatches LeadImportBatch[] @relation("LeadImportBatchUploadedBy")
  createdClients    Client[]             @relation("ClientCreatedBy")
  // Processing
  assignedProcessingCases      ProcessingCase[]             @relation("ProcessingCaseOfficer")
  createdProcessingCases       ProcessingCase[]             @relation("ProcessingCaseCreatedBy")
  updatedProcessingCases       ProcessingCase[]             @relation("ProcessingCaseUpdatedBy")
  processingStageChanges       ProcessingCaseStageHistory[] @relation("StageChangedBy")
  createdDocTemplates          DocumentRequirementTemplate[] @relation("DocTemplateCreatedBy")
  waivedDocItems               CaseDocumentItem[]           @relation("DocItemWaivedBy")
  uploadedDocVersions          ClientDocumentVersion[]      @relation("DocVersionUploadedBy")
  reviewedDocDecisions         DocumentReviewDecision[]     @relation("DocReviewedBy")
  docAccessLogs                DocumentAccessLog[]          @relation("DocAccessedBy")
  raisedCorrectionRequests     CorrectionRequest[]          @relation("CorrectionRaisedBy")
  resolvedCorrectionRequests   CorrectionRequest[]          @relation("CorrectionResolvedBy")
  sentCaseCommunications       CaseCommunication[]          @relation("CaseCommunicationSentBy")
  processingNotes              ProcessingNote[]             @relation("ProcessingNoteCreatedBy")
  assignedProcessingTasks      ProcessingTask[]             @relation("TaskAssignedTo")
  createdProcessingTasks       ProcessingTask[]             @relation("TaskCreatedBy")
  completedProcessingTasks     ProcessingTask[]             @relation("TaskCompletedBy")
  authoritySubmissions         AuthoritySubmission[]        @relation("AuthoritySubmittedBy")
  processingAuditLogs          ProcessingAuditLog[]         @relation("ProcessingAuditActor")
  completedCaseMilestones      CaseMilestone[]              @relation("CaseMilestoneCompletedBy")

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("user_accounts")
  @@schema("core")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  grantedAt DateTime @default(now())
  grantedBy String?

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
  @@schema("core")
}

model LoginSession {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("login_sessions")
  @@schema("core")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
  @@schema("core")
}

// =============================================================================
// EMPLOYEES
// =============================================================================

model Employee {
  id              String    @id @default(uuid())
  userId          String    @unique
  departmentId    String?
  branchId        String?
  designationId   String?
  employeeCode    String?   @unique
  firstName       String
  lastName        String
  gender          Gender?
  dateOfBirth     DateTime?
  nationalId      String?
  passportNumber  String?
  nationality     String?
  joiningDate     DateTime?
  profilePhotoKey String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // --- WhatsApp inbox membership + presence + skills -----------------------
  // True if this employee participates in WhatsApp round-robin assignment.
  whatsappInboxMember Boolean        @default(false)
  // Manual availability toggle set by the agent (Online/Away/Offline). Drives
  // the topbar pill AND lead routing (Away/Offline = no new leads). Defaults to
  // ONLINE so a new agent receives leads unless they deliberately opt out.
  presenceStatus      PresenceStatus @default(ONLINE)
  // Last WebSocket / REST heartbeat. >5min idle => effectively AWAY.
  lastActivityAt      DateTime?
  // Last time the user explicitly flipped their presence.
  presenceChangedAt   DateTime?
  // Skill tags used as a soft preference by the routing engine. Examples:
  // ["UK","Canada","StudentVisa","WorkPermit"].
  skills              String[]       @default([])

  // --- Response-SLA scoring -----------------------------------------------
  // Lifetime tallies of agent replies that landed within / outside the
  // Response-SLA window. Score% = met / (met + breached) * 100, defaulting
  // to 100 when there's no history yet — so every agent STARTS at 100 and
  // works to keep it there. slaBreachCount drives the "10 breaches" warning.
  slaResponsesMet     Int            @default(0)
  slaResponsesBreached Int           @default(0)

  // --- Presence accountability (consequences for manual Away/Offline) ------
  // Penalty subtracted from the displayed SLA score; recovers +1 per day.
  slaPenaltyPoints     Int       @default(0)
  // Per-day minute accruals counted ONLY during working hours; reset when
  // presenceCountersDate (Asia/Karachi 'YYYY-MM-DD') rolls to a new day.
  awayMinutesToday     Int       @default(0)
  offlineMinutesToday  Int       @default(0)
  presenceCountersDate String?
  // Once-per-episode Away nudge (>10 min continuous); cleared on leaving Away.
  awayWarnedAt         DateTime?
  // Once-per-day guards ('YYYY-MM-DD'): offline penalty applied / penalty decayed.
  offlinePenalizedDate String?
  penaltyDecayDate     String?

  user        UserAccount  @relation(fields: [userId], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])
  assignedLeads     Lead[]    @relation("LeadEmployee")
  preferredByLeads  Lead[]    @relation("LeadPreferredEmployee")
  assignedCases     Case[]    @relation("CaseAssignedEmployee")
  assignedFollowUps FollowUp[] @relation("FollowUpAssignedEmployee")
  whatsappSentMessages WhatsAppMessage[] @relation("WhatsAppMessageSentBy")
  // Sales rep that originally owned the lead and stays with the client
  // after conversion. Used so processing can ping the original salesperson.
  assignedClients   Client[]   @relation("ClientAssignedEmployee")

  @@index([departmentId])
  @@index([branchId])
  @@index([whatsappInboxMember, presenceStatus])
  @@map("employees")
  @@schema("core")
}

/// End-of-day snapshot of an agent's manual-presence accountability, written by
/// the 6 PM job. Denormalised (employeeName stored) so the historical report
/// stays accurate even if the employee is later renamed or removed.
model PresenceDailyReport {
  id             String   @id @default(uuid())
  employeeId     String
  reportDate     String   // 'YYYY-MM-DD' (Asia/Karachi)
  employeeName   String
  awayMinutes    Int      @default(0)
  offlineMinutes Int      @default(0)
  penaltyApplied Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([employeeId, reportDate])
  @@index([reportDate])
  @@map("presence_daily_reports")
  @@schema("core")
}

model Partner {
  id              String        @id @default(uuid())
  organizationId  String
  branchId        String?
  userId          String?       @unique
  companyName     String
  contactName     String
  email           String?
  phone           String?
  referralCode    String        @unique
  status          PartnerStatus @default(ACTIVE)
  notes           String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  user         UserAccount? @relation(fields: [userId], references: [id])
  leads        Lead[]

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@index([email])
  @@index([phone])
  @@map("partners")
  @@schema("core")
}

// =============================================================================
// LEADS
// =============================================================================

model Lead {
  id                 String     @id @default(uuid())
  /// Human-readable, sequential reference code (TIS-YYYY-NNNNN). Generated
  /// on insert by leads.service. Stays with the lead through conversion —
  /// the resulting Client inherits the same code so the customer carries
  /// one identifier from first contact through final payment + processing.
  referenceCode      String     @unique
  branchId           String?
  assignedEmployeeId String?
  createdByUserId    String?
  firstName          String
  lastName           String
  email              String?
  phone              String
  alternatePhone     String?
  nationality        String?
  targetCountry      String?
  serviceInterest    String?
  /// Agreed total fee for the service the lead signed up for. Captured by
  /// Sales (Edit Lead modal) when the deal is set. Becomes the totalAmount
  /// on the single Invoice that all installment Payments roll up to. NULL
  /// while the deal is still being negotiated — finance falls back to the
  /// first handover's submittedAmount in that case.
  serviceFeeAmount   Decimal? @db.Decimal(12, 2)
  serviceFeeCurrency String?
  sourceChannel      String?
  referralPartnerId  String?
  status             LeadStatus @default(NEW)
  priority           String?
  notes              String?
  lostReason         String?
  convertedAt        DateTime?
  convertedClientId  String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  // --- Email verification ---------------------------------------------------
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?   @unique
  emailVerificationSentAt DateTime?
  emailVerifiedAt        DateTime?

  // --- WhatsApp routing -----------------------------------------------------
  // Sticky routing: lifetime preferred employee for this lead. Set on first
  // assignment. Future inbound on the same lead returns to this employee when
  // they're available; otherwise round-robin fallback.
  preferredEmployeeId String?

  branch              Branch?      @relation(fields: [branchId], references: [id])
  assignedEmployee    Employee?    @relation("LeadEmployee", fields: [assignedEmployeeId], references: [id])
  preferredEmployee   Employee?    @relation("LeadPreferredEmployee", fields: [preferredEmployeeId], references: [id])
  createdBy           UserAccount? @relation("LeadCreatedBy", fields: [createdByUserId], references: [id])
  referralPartner     Partner?     @relation(fields: [referralPartnerId], references: [id])
  appointments        Appointment[] @relation("LeadAppointments")
  invoices            Invoice[]     @relation("LeadInvoices")
  serviceContracts    ServiceContract[] @relation("LeadServiceContracts")
  followUps           FollowUp[]
  financeHandovers    FinanceHandover[]
  receipts            Receipt[]
  timelineEvents      ActivityTimeline[]
  processingCases     ProcessingCase[]
  whatsappThread      WhatsAppThread? @relation("LeadWhatsAppThread")
  whatsappMessages    WhatsAppMessage[] @relation("LeadWhatsAppMessages")
  incomingEmails      IncomingEmail[]   @relation("LeadIncomingEmails")
  // Reverse of Client.sourceLeadId. Typically 0..1 Client per Lead, but the
  // relation is modelled as one-to-many to keep Prisma's type generation
  // happy.
  derivedClients      Client[]    @relation("ClientSourceLead")

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([assignedEmployeeId])
  @@index([branchId])
  @@index([referralPartnerId])
  @@index([preferredEmployeeId])
  /// Matches `WHERE deletedAt IS NULL ORDER BY createdAt DESC` — the
  /// dominant list query. Cuts the 3s full-scan-and-sort down to ~50ms.
  @@index([deletedAt, createdAt(sort: Desc)])
  @@map("leads")
  @@schema("crm")
  files               LeadFile[]
  importRows          LeadImportRow[]
  metaSubmissions     MetaLeadSubmission[]
}

/// Meta (Facebook/Instagram) Lead Ads form submission. One row per leadgen
/// event from Meta's webhook. `leadgenId` is unique → idempotency for Meta's
/// webhook retries + dedupe guard. The matched/created Lead carries
/// sourceChannel='meta-lead-form'; this row holds the campaign/form/ad
/// attribution + the raw answers, surfaced on the lead detail UI and used for
/// Meta Lead Form campaign performance reporting.
model MetaLeadSubmission {
  id            String    @id @default(uuid())
  leadId        String
  leadgenId     String    @unique
  formId        String?
  formName      String?
  adId          String?
  adName        String?
  adsetId       String?
  adsetName     String?
  campaignId    String?
  campaignName  String?
  pageId        String?
  platform      String?
  isOrganic     Boolean?
  /// True when this submission matched an EXISTING lead instead of creating a
  /// new one (repeat customer). Lets admin surface duplicate submissions.
  isDuplicate   Boolean   @default(false)
  /// Customer's answers — the raw Meta `field_data` array of {name, values}.
  formAnswers   Json?
  /// Full Graph API lead response, kept for forensics / re-mapping.
  rawPayload    Json?
  /// Meta's `created_time` for the submission.
  metaCreatedAt DateTime?
  createdAt     DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([campaignId])
  @@index([formId])
  @@map("lead_meta_submissions")
  @@schema("crm")
}

/// Bulk lead upload from CSV/Excel. Each upload creates one batch row.
/// Counts are denormalised onto the batch for fast dashboard render —
/// they're updated by the lead-import worker as each row is processed.
model LeadImportBatch {
  id              String                @id @default(uuid())
  /// Sequential reference LB-YYYY-NNNNN. Generated on insert.
  batchNumber     String                @unique
  /// Human label admin sets when uploading. e.g. "May FB Ads".
  name            String
  uploadedByUserId String
  uploadedAt      DateTime              @default(now())

  // Source file (kept for forensics + re-download).
  fileName        String
  fileKey         String
  fileMimeType    String?
  fileSizeBytes   Int?

  // Counts (live-updated by the worker)
  totalRows       Int                   @default(0)
  importedCount   Int                   @default(0)
  duplicateCount  Int                   @default(0)
  invalidCount    Int                   @default(0)
  assignedCount   Int                   @default(0)

  status          LeadImportStatus      @default(QUEUED)

  /// The agent pool the admin chose at upload time. Subset of (or equal to)
  /// the WhatsApp/sales pool. Empty means "use whoever is currently eligible".
  selectedAgentIds  String[]            @default([])

  /// CSV-header → lead-field map the admin applied at upload time.
  /// Shape: { phone: "Mobile Number", firstName: "Name", country: "Country", ... }
  columnMapping     Json

  /// Default country code used when normalising phones in this batch
  /// (e.g. "PK" turns "03331120001" into "+923331120001"). Per-batch
  /// rather than global because admins sometimes upload mixed-origin lists.
  defaultCountry    String              @default("PK")

  /// Per-batch override of the global welcome message template. NULL = use
  /// global default.
  welcomeMessage    String?

  /// Generated post-run CSV of every row that failed (with reason).
  /// Downloadable from the batch detail page.
  errorReportKey    String?

  startedAt         DateTime?
  completedAt       DateTime?
  pausedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  /// Soft-delete marker. When admin "deletes" a batch via the admin UI we
  /// stamp this + cascade soft-delete every Lead created from this batch.
  /// The row itself is kept so the audit trail (who uploaded what / when /
  /// counts) survives — we just hide it from the lead-imports list.
  deletedAt         DateTime?

  uploadedBy        UserAccount         @relation("LeadImportBatchUploadedBy", fields: [uploadedByUserId], references: [id])
  rows              LeadImportRow[]

  @@index([uploadedByUserId])
  @@index([status])
  @@index([uploadedAt(sort: Desc)])
  @@map("lead_import_batches")
  @@schema("crm")
}

/// One row of one batch's source file, post-validation. Carries the
/// original raw cell values for audit even when validation failed, and
/// links to the resulting Lead (whether newly created or matched by dedupe).
model LeadImportRow {
  id                 String                @id @default(uuid())
  batchId            String
  /// 1-based row number in the original file (excluding header).
  rowNumber          Int
  /// Full original row as the parser read it — for diffing / forensics.
  rawData            Json
  /// Phone after normalisation to E.164. NULL when normalisation failed.
  normalisedPhone    String?
  outcome            LeadImportRowOutcome
  errorMessage       String?
  /// Set when outcome=IMPORTED (the lead we created) OR DUPLICATE (the
  /// pre-existing lead this row's phone matched). NULL for INVALID/FAILED.
  leadId             String?
  /// The agent the round-robin engine picked for this row (NULL when
  /// the row didn't create a new assignment — e.g. duplicate that kept
  /// its existing assignee).
  assignedEmployeeId String?
  createdAt          DateTime              @default(now())

  batch              LeadImportBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lead               Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([leadId])
  @@index([outcome])
  @@map("lead_import_rows")
  @@schema("crm")
}

model LeadFile {
  id               String   @id @default(uuid())
  leadId           String
  uploadedByUserId String?
  fileName         String
  fileKey          String
  fileMimeType     String?
  fileSizeBytes    Int?
  createdAt        DateTime @default(now())

  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_files")
  @@schema("crm")
}

model FollowUp {
  id                 String           @id @default(uuid())
  leadId             String
  assignedEmployeeId String?
  createdByUserId    String
  completedByUserId  String?
  title              String
  description        String?
  contactMethod      String?
  dueAt              DateTime
  status             FollowUpStatus   @default(OPEN)
  priority           FollowUpPriority @default(MEDIUM)
  outcomeNotes       String?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  lead             Lead      @relation(fields: [leadId], references: [id])
  assignedEmployee Employee? @relation("FollowUpAssignedEmployee", fields: [assignedEmployeeId], references: [id])

  @@index([leadId])
  @@index([assignedEmployeeId])
  @@index([status])
  @@index([dueAt])
  @@map("follow_ups")
  @@schema("crm")
}

// =============================================================================
// CLIENTS
// =============================================================================

model Client {
  id                String       @id @default(uuid())
  /// Inherits the originating Lead's referenceCode (TIS-YYYY-NNNNN) on
  /// conversion. Same identifier carries the customer from first contact
  /// through every invoice + receipt + processing case for life.
  referenceCode     String       @unique
  branchId          String?
  createdByUserId   String?
  firstName         String
  lastName          String
  email             String?      @unique
  phone             String       @unique
  alternatePhone    String?
  nationality       String?
  dateOfBirth       DateTime?
  gender            Gender?
  passportNumber    String?
  passportExpiry    DateTime?
  nationalId        String?
  // CNIC is the Pakistani national-ID format. Stored separately from
  // `nationalId` so the existing field can keep its generic meaning while
  // forms that need a strict CNIC validate this column.
  cnic              String?
  address           String?
  status            ClientStatus @default(NEW_CLIENT)
  portalAccessEnabled Boolean   @default(false)

  // Provenance + ownership. Populated automatically when Finance sends a
  // verified case to Processing (the moment Lead becomes Client). Existing
  // rows were backfilled in the same migration.
  sourceLeadId       String?
  assignedEmployeeId String?
  serviceType        String?
  targetCountry      String?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  branch             Branch?      @relation(fields: [branchId], references: [id])
  createdBy          UserAccount? @relation("ClientCreatedBy", fields: [createdByUserId], references: [id])
  sourceLead         Lead?        @relation("ClientSourceLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  assignedEmployee   Employee?    @relation("ClientAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  cases              Case[]
  documents          ClientDocument[]
  appointments       Appointment[] @relation("ClientAppointments")
  invoices           Invoice[]     @relation("ClientInvoices")
  serviceContracts   ServiceContract[] @relation("ClientServiceContracts")
  receipts           Receipt[]
  timelineEvents     ActivityTimeline[]
  processingCases    ProcessingCase[]
  reminders          ClientReminder[]
  // WhatsApp chat history follows the client after lead-to-client conversion.
  whatsappThreads    WhatsAppThread[]  @relation("ClientWhatsAppThreads")
  whatsappMessages   WhatsAppMessage[] @relation("ClientWhatsAppMessages")
  incomingEmails     IncomingEmail[]   @relation("ClientIncomingEmails")

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([branchId])
  @@index([sourceLeadId])
  @@index([assignedEmployeeId])
  @@map("clients")
  @@schema("crm")
}

// =============================================================================
// CASES
// =============================================================================

model Case {
  id                 String     @id @default(uuid())
  clientId           String
  departmentId       String?
  assignedEmployeeId String?
  caseNumber         String     @unique
  serviceType        String
  targetCountry      String
  status             CaseStatus @default(OPEN)
  priority           String?
  notes              String?
  submissionDeadline DateTime?
  submittedAt        DateTime?
  decidedAt          DateTime?
  decisionNotes      String?
  createdByUserId    String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  client           Client     @relation(fields: [clientId], references: [id])
  department       Department? @relation(fields: [departmentId], references: [id])
  assignedEmployee Employee?   @relation("CaseAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  documents        ClientDocument[]
  appointments     Appointment[]
  timelineEvents   ActivityTimeline[]

  @@index([clientId])
  @@index([status])
  @@index([assignedEmployeeId])
  @@index([departmentId])
  @@map("cases")
  @@schema("processing")
}

// =============================================================================
// DOCUMENTS
// =============================================================================

model DocumentRequirement {
  id            String  @id @default(uuid())
  serviceType   String
  targetCountry String?
  name          String
  description   String?
  isRequired    Boolean @default(true)
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clientDocuments ClientDocument[]

  @@index([serviceType])
  @@map("document_requirements")
  @@schema("processing")
}

model ClientDocument {
  id                    String         @id @default(uuid())
  clientId              String
  caseId                String?
  documentRequirementId String?
  uploadedByUserId      String?
  reviewedByUserId      String?
  name                  String
  description           String?
  fileKey               String
  fileMimeType          String?
  fileSizeBytes         Int?
  status                DocumentStatus @default(PENDING)
  expiryDate            DateTime?
  rejectionReason       String?
  reviewedAt            DateTime?
  isConfidential        Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  client              Client               @relation(fields: [clientId], references: [id])
  case                Case?                @relation(fields: [caseId], references: [id])
  documentRequirement DocumentRequirement? @relation(fields: [documentRequirementId], references: [id])
  aiJobs              AiJob[]

  @@index([clientId])
  @@index([caseId])
  @@index([status])
  @@map("client_documents")
  @@schema("processing")
}

// =============================================================================
// APPOINTMENTS
// =============================================================================

model Appointment {
  id               String            @id @default(uuid())
  leadId           String?
  clientId         String?
  caseId           String?
  assignedEmployeeId String?
  createdByUserId  String?
  title            String
  appointmentType  String
  status           AppointmentStatus @default(SCHEDULED)
  scheduledAt      DateTime
  durationMinutes  Int               @default(30)
  location         String?
  meetingLink      String?
  notes            String?
  reminderSentAt   DateTime?
  completedAt      DateTime?
  cancellationReason String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  lead   Lead?   @relation("LeadAppointments", fields: [leadId], references: [id])
  client Client? @relation("ClientAppointments", fields: [clientId], references: [id])
  case   Case?   @relation(fields: [caseId], references: [id])

  @@index([leadId])
  @@index([clientId])
  @@index([caseId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
  @@schema("crm")
}

// =============================================================================
// FINANCE
// =============================================================================

/// Monotonic, gapless per-year counter for regulated document numbers
/// (INV/RCP/SC/AGR). Unlike a row COUNT(), this never decrements when rows
/// are voided/removed, so a number is issued exactly once — an audit
/// requirement. Incremented atomically via INSERT ... ON CONFLICT.
model DocumentSequence {
  series    String
  year      Int
  lastValue Int    @default(0)

  @@id([series, year])
  @@map("document_sequences")
  @@schema("finance")
}

model Invoice {
  id              String        @id @default(uuid())
  leadId          String?
  clientId        String?
  caseId          String?
  /// If this invoice was auto-generated for a specific installment of a
  /// signed service contract, this points back to that installment. NULL
  /// for invoices created directly (the original pattern, predates
  /// service contracts).
  installmentId   String?       @unique
  invoiceNumber   String        @unique
  status          InvoiceStatus @default(DRAFT)
  currency        String        @default("CAD")
  subtotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @db.Decimal(12, 2) @default(0)
  discountAmount  Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @db.Decimal(12, 2) @default(0)
  dueDate         DateTime?
  notes           String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  /// Soft-delete / void marker. Financial documents are never hard-deleted —
  /// corrections go via void + reversing entry so the audit trail is intact.
  deletedAt       DateTime?

  lead     Lead?     @relation("LeadInvoices", fields: [leadId], references: [id])
  client   Client?   @relation("ClientInvoices", fields: [clientId], references: [id])
  installment Installment? @relation(fields: [installmentId], references: [id])
  payments Payment[]
  receipts Receipt[]
  creditNotes CreditNote[]
  financeHandovers FinanceHandover[]

  @@index([leadId])
  @@index([clientId])
  @@index([status])
  @@map("invoices")
  @@schema("finance")
}

/// A signed service contract between the firm and a lead/client. Captures
/// the agreed total fee and the installment schedule. Each installment
/// becomes an `Invoice` when its due-date arrives (or when manually
/// triggered by Finance). Drives the per-installment billing loop the
/// client expects ("Generate Next Installment Invoice" in the accounting
/// flowchart).
model ServiceContract {
  id              String                @id @default(uuid())
  /// Sequential reference SC-YYYY-NNNNN. Generated on insert.
  contractNumber  String                @unique
  /// Originating lead. Required at creation — the client record may not
  /// exist yet at the moment of signing.
  leadId          String?
  /// Client after lead conversion. One of leadId/clientId is required.
  clientId        String?
  totalAmount     Decimal               @db.Decimal(12, 2)
  currency        String                @default("CAD")
  /// When the lead actually signed the agreement.
  signedDate      DateTime?
  /// Storage key for the uploaded agreement PDF (S3).
  agreementKey       String?
  agreementFileName  String?
  agreementMimeType  String?
  agreementSizeBytes Int?
  status          ServiceContractStatus @default(DRAFT)
  notes           String?
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  lead         Lead?         @relation("LeadServiceContracts", fields: [leadId], references: [id])
  client       Client?       @relation("ClientServiceContracts", fields: [clientId], references: [id])
  installments Installment[]

  @@index([leadId])
  @@index([clientId])
  @@index([status])
  @@map("service_contracts")
  @@schema("finance")
}

/// One scheduled installment of a `ServiceContract`. Becomes an Invoice
/// when generated (manually or by the scheduler). Status tracks the
/// lifecycle independently from the Invoice (an installment can be
/// PENDING with no Invoice yet, INVOICED with a draft Invoice waiting on
/// payment, PAID once the linked Invoice's Payment is verified, etc.).
model Installment {
  id            String            @id @default(uuid())
  contractId    String
  sequence      Int
  dueDate       DateTime
  amount        Decimal           @db.Decimal(12, 2)
  /// Human-readable label, e.g. "First installment on signing", "On visa
  /// approval", "After medical exam".
  description   String?
  status        InstallmentStatus @default(PENDING)
  /// Revenue recognition (accrual): set when this milestone / performance
  /// obligation is actually delivered. Revenue is EARNED at this point
  /// regardless of when cash arrived; until then, cash collected against the
  /// contract is unearned (deferred) revenue — a liability, not income.
  recognizedAt       DateTime?
  recognizedByUserId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  contract ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoice  Invoice?

  @@unique([contractId, sequence])
  @@index([contractId])
  @@index([status])
  @@index([dueDate])
  @@map("installments")
  @@schema("finance")
}

model Payment {
  id               String        @id @default(uuid())
  invoiceId        String
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("CAD")
  /// FX: `amount`/`currency` are what was actually received (e.g. PKR on the
  /// bank slip). `baseAmount` is the CAD equivalent booked to the ledger and
  /// `fxRate` is the rate used (1 CAD = fxRate <currency>), stamped at record
  /// time so historical records never move when the live rate changes.
  baseAmount       Decimal?      @db.Decimal(12, 2)
  baseCurrency     String        @default("CAD")
  fxRate           Decimal?      @db.Decimal(18, 8)
  status           PaymentStatus @default(PENDING)
  paymentMethod    String?
  transactionRef   String?
  paidAt           DateTime?
  verifiedByUserId String?
  verifiedAt       DateTime?
  notes            String?
  /// Internal-only annotation (NOT shown on client-facing PDFs). Used for
  /// audit breadcrumbs like "handover:<id>" that link a payment back to the
  /// workflow row that created it, without polluting the client's receipt.
  internalReference String?
  receiptKey       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  /// Soft-delete / void marker — payments are never hard-deleted (audit).
  deletedAt        DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  financeHandover FinanceHandover?
  receipt Receipt?

  @@index([invoiceId])
  @@index([status])
  @@map("payments")
  @@schema("finance")
}

/// Formal receipt issued per verified Payment. One Receipt per Payment
/// (enforced by the unique paymentId FK). Holds the sequential
/// receiptNumber that's regulatory in most jurisdictions, plus the
/// storage key for the rendered PDF. The PDF is a regeneratable artifact
/// — the source of truth lives in this row.
model Receipt {
  id                String   @id @default(uuid())
  receiptNumber     String   @unique
  paymentId         String   @unique
  leadId            String?
  clientId          String?
  invoiceId         String
  amount            Decimal  @db.Decimal(12, 2)
  currency          String
  paymentMethod     String?
  transactionRef    String?
  issuedByUserId    String
  issuedAt          DateTime @default(now())
  // S3 key for the rendered PDF. NULL until the render completes; the
  // download endpoint will trigger a regenerate if it's missing.
  pdfStorageKey     String?
  pdfGeneratedAt    DateTime?
  voidedAt          DateTime?
  voidReason        String?
  voidedByUserId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([clientId])
  @@index([invoiceId])
  @@index([issuedAt])
  @@map("receipts")
  @@schema("finance")
}

/// Credit note — the contra-document a CA expects when money is returned or an
/// invoice is reduced (refund, cancellation, billing correction). Issued with
/// its own sequential number (CN-YYYY-NNNNN) and dated in the period the
/// reversal happens, so the original invoice/receipt stay intact and the
/// refund shows as an explicit negative entry rather than silently vanishing.
model CreditNote {
  id               String    @id @default(uuid())
  creditNoteNumber String    @unique
  invoiceId        String
  /// The payment being reversed, when the credit note stems from a refund.
  paymentId        String?
  leadId           String?
  clientId         String?
  amount           Decimal   @db.Decimal(12, 2)
  currency         String
  reason           String?
  issuedByUserId   String
  issuedAt         DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([clientId])
  @@index([leadId])
  @@index([issuedAt])
  @@map("credit_notes")
  @@schema("finance")
}

model FinanceHandover {
  id               String                @id @default(uuid())
  leadId           String
  invoiceId        String?
  paymentId        String?               @unique
  createdByUserId  String
  reviewedByUserId String?
  status           FinanceHandoverStatus @default(SUBMITTED)
  submittedAmount  Decimal               @db.Decimal(12, 2)
  currency         String                @default("CAD")
  paymentMethod    String?
  transactionRef   String?
  notes            String?
  financeNotes     String?
  receiptKey       String
  receiptFileName  String
  receiptMimeType  String?
  receiptSizeBytes Int?
  submittedAt      DateTime              @default(now())
  reviewedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  lead           Lead           @relation(fields: [leadId], references: [id])
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  payment        Payment?       @relation(fields: [paymentId], references: [id])
  processingCase ProcessingCase?

  @@index([leadId])
  @@index([invoiceId])
  @@index([status])
  @@index([createdByUserId])
  @@map("finance_handovers")
  @@schema("finance")
}

enum ExpenseCategory {
  GOVERNMENT_FEE // visa / immigration / application fees paid to a government
  EMBASSY        // embassy / consulate charges
  MEDICAL        // medicals, biometrics
  TRANSLATION    // document translation / attestation
  COURIER        // shipping / courier of documents
  THIRD_PARTY    // any other paid vendor on the client's behalf
  OTHER

  @@schema("finance")
}

/// Money the firm spends ON BEHALF of a customer (cost side of the ledger) —
/// government/embassy fees, medical, translation, courier, etc. Pairs with
/// the revenue side (invoices/payments) to give a per-client margin. Decoupled
/// like Agreement: plain leadId/clientId/caseId columns, no Prisma relations,
/// so it never forces back-relations onto Lead/Client/ProcessingCase. Soft
/// deletable; an optional receipt of the spend can be attached.
model Expense {
  id               String          @id @default(uuid())
  leadId           String
  clientId         String?
  caseId           String?
  category         ExpenseCategory @default(OTHER)
  description      String
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("CAD")
  /// FX: CAD equivalent of `amount` + the rate used (1 CAD = fxRate <currency>),
  /// stamped at entry. Reports/margin use baseAmount so everything rolls up in CAD.
  baseAmount       Decimal?        @db.Decimal(12, 2)
  baseCurrency     String          @default("CAD")
  fxRate           Decimal?        @db.Decimal(18, 8)
  /// Recoverable input tax (GST/HST/VAT) paid on this expense — claimable as
  /// an input tax credit (ITC) and netted against output tax in the tax
  /// report. 0 when no tax applies or it isn't recoverable.
  taxAmount        Decimal         @default(0) @db.Decimal(12, 2)
  /// Rebillable disbursement (client reimburses) vs absorbed firm cost.
  /// Billable expenses are recoverable — they do NOT reduce margin and are
  /// owed by the client. Absorbed (default) reduce margin as a true cost.
  billable         Boolean         @default(false)
  incurredAt       DateTime        @default(now())
  receiptKey       String?
  receiptFileName  String?
  receiptMimeType  String?
  receiptSizeBytes Int?
  createdByUserId  String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  @@index([leadId])
  @@index([clientId])
  @@index([caseId])
  @@index([category])
  @@map("expenses")
  @@schema("finance")
}

// =============================================================================
// SERVICE AGREEMENTS (template-driven authoring → Sales → Finance → Client)
// =============================================================================

enum AgreementStatus {
  DRAFT                // Sales drafting
  SUBMITTED            // Sent to Finance for review
  FINANCE_REVIEW       // Finance is reviewing
  CHANGES_REQUESTED    // Finance bounced it back to Sales
  APPROVED             // Finance approved
  EDITED_PENDING_SALES // Finance edited payment terms; Sales must confirm
  SENT                 // Sent to the client
  SIGNED               // Client signed / accepted
  CANCELLED

  @@schema("finance")
}

enum PaymentPlanType {
  FULL          // single full payment
  INSTALLMENT   // fixed installments
  MILESTONE     // milestone/stage-triggered payments

  @@schema("finance")
}

/// Reusable per-category agreement template: the legal body (HTML with
/// {{placeholders}} and a {{PAYMENT_PLAN}} slot) plus default Annexure-A stage
/// labels. Seeded from the firm's drafts; admin-editable later. Referenced by
/// id (no FK relation) to keep it decoupled.
model AgreementTemplate {
  id            String   @id @default(uuid())
  categoryKey   String   @unique          // 'C11', 'C10', 'EB2_NIW', 'E2', ...
  name          String                    // "C11 Business Permit – Canada"
  programTitle  String                    // "C11 BUSINESS PERMIT FEDERAL PROGRAM – CANADA"
  bodyHtml      String                    // clauses HTML w/ {{bio}} + {{PAYMENT_PLAN}}
  defaultStages Json?                     // default stage labels for the payment plan
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("agreement_templates")
  @@schema("finance")
}

/// A concrete agreement authored for a lead: applicant bio + structured payment
/// plan + the edited document, moving Sales → Finance → Client. On approval/
/// signing it materialises into a ServiceContract (the existing installment /
/// invoice / payment / lead-to-client pipeline takes over downstream).
/// leadId/clientId/templateId are id references (no FK) to stay decoupled.
model Agreement {
  id                      String          @id @default(uuid())
  agreementNumber         String          @unique
  leadId                  String
  clientId                String?
  templateId              String
  categoryKey             String
  status                  AgreementStatus @default(DRAFT)
  currency                String          @default("CAD")
  /// Net payable (gross − discount). The single headline amount owed.
  totalAmount             Decimal         @default(0) @db.Decimal(12, 2)
  grossAmount             Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount          Decimal         @default(0) @db.Decimal(12, 2)
  paymentPlanType         PaymentPlanType?
  bioData                 Json            // { applicantName, cnic, address, email, phone, fileNumber, date }
  paymentPlan             Json            // { planType, currency, grossAmount, discountAmount, netPayable, installments[], ... }
  contentHtml             String          // edited agreement body (template + data, then edited)
  generatedPdfKey         String?
  generatedPdfAt          DateTime?
  serviceContractId       String?
  salesNotes              String?
  financeNotes            String?
  createdByUserId         String
  financeReviewedByUserId String?
  /// Set when Finance approves: the plan is locked. Any later change reverts
  /// status to Finance review and is recorded in agreement_events.
  paymentPlanLockedAt        DateTime?
  paymentPlanLockedByUserId  String?
  submittedAt             DateTime?
  reviewedAt              DateTime?
  sentAt                  DateTime?
  signedAt                DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  deletedAt               DateTime?

  @@index([leadId])
  @@index([clientId])
  @@index([status])
  @@index([categoryKey])
  @@map("agreements")
  @@schema("finance")
}

/// Append-only change history for an agreement (created / updated / submitted /
/// approved / plan-edited-after-lock …). Decoupled by id (no FK) like the rest
/// of the agreement model. Gives Finance a full audit trail with before/after.
model AgreementEvent {
  id          String   @id @default(uuid())
  agreementId String
  actorUserId String?
  type        String   // CREATED | UPDATED | SUBMITTED | APPROVED | CHANGES_REQUESTED | PLAN_RELOCKED | ...
  summary     String
  dataBefore  Json?
  dataAfter   Json?
  createdAt   DateTime @default(now())

  @@index([agreementId])
  @@index([createdAt])
  @@map("agreement_events")
  @@schema("finance")
}

// =============================================================================
// AUDIT LOG
