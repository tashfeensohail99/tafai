// =============================================================================
// PROCESSING MODULE — ENUMS
// =============================================================================

enum ProcessingCaseStage {
  INTAKE_PENDING
  DOCUMENTS_COLLECTION
  DOCUMENTS_UNDER_REVIEW
  DOCUMENTS_INCOMPLETE
  DOCUMENTS_COMPLETE
  READY_FOR_SUBMISSION
  SUBMITTED
  UNDER_AUTHORITY_REVIEW
  ADDITIONAL_INFO_REQUESTED
  DECISION_RECEIVED
  APPROVED
  REJECTED
  APPEAL_IN_PROGRESS
  COMPLETED
  CANCELLED
  @@schema("processing")
}

enum ProcessingCasePriority {
  LOW
  NORMAL
  URGENT
  CRITICAL
  @@schema("processing")
}

enum ProcessingSlaStatus {
  ACTIVE
  APPROACHING
  BREACHED
  EXTENDED
  COMPLETED
  @@schema("processing")
}

enum AuthorityDecision {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  @@schema("processing")
}

enum DocumentCriticality {
  CRITICAL
  REQUIRED
  CONDITIONAL
  SUPPORTING
  OPTIONAL
  @@schema("processing")
}

enum DocumentItemStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
  EXPIRING_SOON
  WAIVED
  NOT_APPLICABLE
  @@schema("processing")
}

enum DocumentValidityRule {
  NONE
  MUST_NOT_EXPIRE
  MUST_BE_VALID_FOR_N_MONTHS
  @@schema("processing")
}

enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  @@schema("processing")
}

enum DocReviewDecisionType {
  ACCEPTED
  REJECTED
  @@schema("processing")
}

// Phase D — document-processing pipeline. Distinguishes a normal text/PDF
// document (OCR + field extraction) from a PHOTO requirement (passport-size
// portrait validated for background colour / face / blur — not extracted).
enum DocumentKind {
  TEXT_DOCUMENT
  PHOTO
  @@schema("processing")
}

// Phase F (processing automation) — staged "provide-first" grouping shown to
// the client so they don't face a 30-item wall.
enum DocumentStageGroup {
  PROVIDE_FIRST
  NEXT
  LATER
  @@schema("processing")
}

// Phase F — which applicant a document belongs to. v1 builds PRIMARY only, but
// every requirement/item carries the role so dependents (spouse/children) and
// the employer side (LMIA/ICT) are config later, not a migration.
enum ApplicantRole {
  PRIMARY
  SPOUSE
  DEPENDENT
  EMPLOYER
  OTHER
  @@schema("processing")
}

// Phase F — attestation / certified-translation lifecycle for a case document
// (educate-and-nudge; a human can WAIVE per case).
enum DocumentAttestationStatus {
  NOT_REQUIRED
  REQUIRED_PENDING
  DONE
  WAIVED
  @@schema("processing")
}

// What the parser recommends after OCR + validation. The human associate
// still owns the decision unless auto-approve fires (high confidence + all
// checks pass), in which case the system records an automated ACCEPTED.
enum AiSuggestedDecision {
  APPROVE
  REJECT
  NEEDS_REVIEW
  @@schema("processing")
}

// Phase E — where an untriaged inbound document came from.
enum InboundDocumentSource {
  WHATSAPP
  EMAIL
  PORTAL
  MANUAL
  @@schema("processing")
}

enum InboundDocumentStatus {
  PENDING
  FILED
  DISCARDED
  @@schema("processing")
}

enum DocAccessType {
  VIEW
  DOWNLOAD
  @@schema("processing")
}

enum CorrectionType {
  DOCUMENT
  INFORMATION
  @@schema("processing")
}

enum CorrectionRequiredAction {
  REUPLOAD
  CONFIRM
  CORRECT
  CALL_BACK
  @@schema("processing")
}

enum CorrectionStatus {
  SENT
  IN_PROGRESS
  RESOLVED
  ESCALATED
  @@schema("processing")
}

enum CommunicationDirection {
  OFFICER_TO_CLIENT
  CLIENT_TO_OFFICER
  SYSTEM_TO_CLIENT
  @@schema("processing")
}

enum CommunicationMessageType {
  WELCOME
  DOCS_REQUEST
  DOCS_REJECTED_NOTICE
  GENERAL_UPDATE
  STAGE_UPDATE
  INFORMATION_REQUEST
  SUBMISSION_NOTICE
  DECISION_NOTICE
  APPOINTMENT_REQUEST
  REMINDER
  @@schema("processing")
}

enum ProcessingNoteType {
  GENERAL
  ESCALATION
  STRATEGY
  CLIENT_INSIGHT
  AUTHORITY_NOTE
  MANAGER_ONLY
  @@schema("processing")
}

enum ProcessingTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  @@schema("processing")
}

enum ProcessingTaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
  @@schema("processing")
}

enum AuthoritySubmissionStatus {
  SUBMITTED
  ACKNOWLEDGED
  UNDER_REVIEW
  RESPONDED
  WITHDRAWN
  @@schema("processing")
}

enum AuthorityResponseType {
  APPROVAL
  REJECTION
  INFO_REQUEST
  BIOMETRICS_REQUEST
  OTHER
  @@schema("processing")
}

enum ReminderType {
  WELCOME
  DOCS_REQUEST
  DOCS_DEADLINE_7D
  DOCS_DEADLINE_1D
  DOCS_OVERDUE
  DOC_REJECTED
  EXPIRY_30D
  EXPIRY_7D
  STAGE_UPDATE
  SUBMISSION_CONFIRMED
  DECISION_RECEIVED
  @@schema("crm")
}

enum ReminderChannel {
  PORTAL
  WHATSAPP
  EMAIL
  SMS
  @@schema("crm")
}

enum ReminderDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  @@schema("crm")
}

// =============================================================================
// PROCESSING MODULE — MODELS
// =============================================================================

model DocumentRequirementTemplate {
  id                 String               @id @default(uuid())
  service            String
  targetCountry      String
  documentName       String
  description        String?
  instructions       String?
  criticality        DocumentCriticality  @default(REQUIRED)
  conditionRule      Json?
  expectedFormats    String[]             @default(["PDF"])
  maxFileSizeMb      Int                  @default(10)
  validityRule       DocumentValidityRule @default(NONE)
  validityMonths     Int?
  validityBufferDays Int                  @default(30)
  // Phase D: canonical doc-type tag (PASSPORT, BANK_STATEMENT, PHOTOGRAPH…)
  // the parser validates against. NULL => parser auto-detects.
  docType            String?
  documentKind       DocumentKind         @default(TEXT_DOCUMENT)
  // For documentKind=PHOTO: { background, sizeMm, faceRequired, maxBlur }.
  photoSpec          Json?
  guidanceUrl        String?
  // Phase F — program-aware requirement sets + attestation + staging.
  // programCode (C11/ICT/LMIA/VISIT…) layered over the broad `service` bucket;
  // NULL => applies to the whole service. applicantRole supports dependents.
  // prerequisiteTemplateId is a soft reference (no FK) resolved at build time.
  programCode            String?
  applicantRole          ApplicantRole       @default(PRIMARY)
  stageGroup             DocumentStageGroup  @default(NEXT)
  attestationRequired    Boolean             @default(false)
  attestationChain       String?
  translationRequired    Boolean             @default(false)
  prerequisiteTemplateId String?
  whyText                String?
  exampleGoodUrl         String?
  exampleBadUrl          String?
  sortOrder          Int                  @default(0)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  createdByUserId    String?

  createdBy         UserAccount?       @relation("DocTemplateCreatedBy", fields: [createdByUserId], references: [id])
  caseDocumentItems CaseDocumentItem[]

  @@index([service, targetCountry])
  @@index([programCode, targetCountry])
  @@index([isActive])
  @@map("document_requirement_templates")
  @@schema("processing")
}

// Phase F — catalog of program-specific requirement sets so a manager can see
// and maintain "C11 · Canada — last verified 2026-05-31" (immigration rules
// change constantly). Templates reference a (programCode, targetCountry) pair;
// this row holds the human-facing metadata + verification date. verifiedByUserId
// is a soft reference (no FK) to avoid touching the central UserAccount model.
model ProgramRequirementSet {
  id               String    @id @default(uuid())
  programCode      String
  targetCountry    String
  displayName      String
  notes            String?
  isActive         Boolean   @default(true)
  lastVerifiedAt   DateTime?
  verifiedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([programCode, targetCountry])
  @@map("program_requirement_sets")
  @@schema("processing")
}

model ProcessingCase {
  id                      String                 @id @default(uuid())
  financeHandoverId       String                 @unique
  leadId                  String
  // Per the platform rule "No ProcessingCase without Client" — every case is
  // owned by a Client. Lead→Client conversion happens automatically when
  // Finance sends the case to Processing; see ProcessingService.createFromHandover.
  clientId                String
  branchId                String?
  assignedOfficerId       String?
  priority                ProcessingCasePriority @default(NORMAL)
  stage                   ProcessingCaseStage    @default(INTAKE_PENDING)
  slaStatus               ProcessingSlaStatus    @default(ACTIVE)
  slaDueAt                DateTime?
  service                 String
  targetCountry           String
  financeHandoverNote     String?
  processingNote          String?
  estimatedSubmissionDate DateTime?              @db.Date
  actualSubmissionDate    DateTime?              @db.Date
  authorityTrackingRef    String?
  authorityDecision       AuthorityDecision      @default(PENDING)
  authorityDecisionDate   DateTime?              @db.Date
  completedAt             DateTime?
  cancelledAt             DateTime?
  cancellationReason      String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  createdByUserId         String
  updatedByUserId         String?

  financeHandover  FinanceHandover                @relation(fields: [financeHandoverId], references: [id])
  lead             Lead                           @relation(fields: [leadId], references: [id])
  client           Client                         @relation(fields: [clientId], references: [id])
  branch           Branch?                        @relation(fields: [branchId], references: [id])
  assignedOfficer  UserAccount?                   @relation("ProcessingCaseOfficer", fields: [assignedOfficerId], references: [id])
  createdBy        UserAccount                    @relation("ProcessingCaseCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy        UserAccount?                   @relation("ProcessingCaseUpdatedBy", fields: [updatedByUserId], references: [id])
  stageHistory        ProcessingCaseStageHistory[]
  documentItems       CaseDocumentItem[]
  correctionRequests  CorrectionRequest[]
  communications      CaseCommunication[]
  reminders           ClientReminder[]
  notes               ProcessingNote[]
  tasks               ProcessingTask[]
  submissions         AuthoritySubmission[]
  auditLogs           ProcessingAuditLog[]
  milestones          CaseMilestone[]
  inboundDocuments    InboundDocument[]

  @@index([assignedOfficerId])
  @@index([stage])
  @@index([clientId])
  @@index([leadId])
  @@index([priority, stage])
  @@map("processing_cases")
  @@schema("processing")
}

model ProcessingCaseStageHistory {
  id              String               @id @default(uuid())
  caseId          String
  fromStage       ProcessingCaseStage?
  toStage         ProcessingCaseStage
  changedByUserId String
  reason          String?
  notes           String?
  gateCheckResult Json?
  createdAt       DateTime             @default(now())

  case      ProcessingCase @relation(fields: [caseId], references: [id])
  changedBy UserAccount    @relation("StageChangedBy", fields: [changedByUserId], references: [id])

  @@index([caseId])
  @@map("processing_case_stage_history")
  @@schema("processing")
}

model CaseDocumentItem {
  id                 String               @id @default(uuid())
  caseId             String
  templateId         String?
  documentName       String
  description        String?
  criticality        DocumentCriticality  @default(REQUIRED)
  expectedFormats    String[]             @default(["PDF"])
  maxFileSizeMb      Int                  @default(10)
  validityRule       DocumentValidityRule @default(NONE)
  validityMonths     Int?
  validityBufferDays Int                  @default(30)
  // Phase D — copied from the template at acknowledge time so each case
  // carries its own (possibly customised) doc-type + photo requirement.
  docType            String?
  documentKind       DocumentKind         @default(TEXT_DOCUMENT)
  photoSpec          Json?
  // Phase F — copied from the template at acknowledge time (like docType/photoSpec).
  applicantRole      ApplicantRole             @default(PRIMARY)
  stageGroup         DocumentStageGroup        @default(NEXT)
  attestationStatus  DocumentAttestationStatus @default(NOT_REQUIRED)
  attestationChain   String?
  translationStatus  DocumentAttestationStatus @default(NOT_REQUIRED)
  prerequisiteItemId String?
  whyText            String?
  exampleGoodUrl     String?
  exampleBadUrl      String?
  status             DocumentItemStatus   @default(NOT_SUBMITTED)
  latestVersionId    String?              @unique
  validityExpiryDate DateTime?            @db.Date
  expiryAlertSentAt  DateTime?
  lastRequestedAt    DateTime?
  requestDeadline    DateTime?            @db.Date
  waivedByUserId     String?
  waiveReason        String?
  sortOrder          Int                  @default(0)
  isAddedManually    Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  case               ProcessingCase                  @relation(fields: [caseId], references: [id])
  template           DocumentRequirementTemplate?    @relation(fields: [templateId], references: [id])
  waivedBy           UserAccount?                    @relation("DocItemWaivedBy", fields: [waivedByUserId], references: [id])
  latestVersion      ClientDocumentVersion?          @relation("LatestDocVersion", fields: [latestVersionId], references: [id])
  versions           ClientDocumentVersion[]         @relation("DocItemVersions")
  reviewDecisions    DocumentReviewDecision[]
  aiAssessments      DocumentAiAssessment[]
  correctionRequests CorrectionRequest[]

  @@index([caseId])
  @@index([status, caseId])
  @@index([validityExpiryDate])
  @@map("case_document_items")
  @@schema("processing")
}

model ClientDocumentVersion {
  id               String          @id @default(uuid())
  documentItemId   String
  caseId           String
  clientId         String?
  storageKey       String
  fileName         String
  fileSizeBytes    Int?
  mimeType         String?
  versionNumber    Int
  uploadedAt       DateTime        @default(now())
  uploadedByUserId String?
  virusScanStatus  VirusScanStatus @default(PENDING)
  virusScanAt      DateTime?
  isCurrent        Boolean         @default(true)

  documentItem    CaseDocumentItem              @relation("DocItemVersions", fields: [documentItemId], references: [id])
  isLatestFor     CaseDocumentItem?             @relation("LatestDocVersion")
  uploadedBy      UserAccount?                  @relation("DocVersionUploadedBy", fields: [uploadedByUserId], references: [id])
  reviewDecisions DocumentReviewDecision[]
  aiAssessments   DocumentAiAssessment[]
  accessLogs      DocumentAccessLog[]

  @@index([documentItemId])
  @@index([caseId])
  @@map("client_document_versions")
  @@schema("processing")
}

model DocumentReviewDecision {
  id                   String                @id @default(uuid())
  documentItemId       String
  versionId            String
  decision             DocReviewDecisionType
  rejectionReasonCodes String[]
  rejectionNote        String?
  // Nullable: an automated (auto-approve) decision has no human reviewer.
  reviewedByUserId     String?
  isAutomated          Boolean               @default(false)
  // One-to-one link back to the AI assessment that produced an automated
  // decision (NULL for purely human decisions).
  aiAssessmentId       String?               @unique
  createdAt            DateTime              @default(now())

  documentItem CaseDocumentItem       @relation(fields: [documentItemId], references: [id])
  version      ClientDocumentVersion  @relation(fields: [versionId], references: [id])
  reviewedBy   UserAccount?           @relation("DocReviewedBy", fields: [reviewedByUserId], references: [id])
  aiAssessment DocumentAiAssessment?  @relation(fields: [aiAssessmentId], references: [id])

  @@index([documentItemId])
  @@map("document_review_decisions")
  @@schema("processing")
}

// Phase D — shadow + auto-approve store. The parser writes one row per
// document version it assesses; the backend reads suggestedDecision +
// checks to either surface a suggestion to the associate (shadow) or fire
// an automated ACCEPTED (auto-approve) when confidence is high and every
// check passes. Never overwrites the human DocumentReviewDecision record.
model DocumentAiAssessment {
  id                String              @id @default(uuid())
  documentItemId    String
  versionId         String
  caseId            String
  detectedDocType   String?
  expectedDocType   String?
  confidence        Float?
  extracted         Json?
  checks            Json?
  suggestedDecision AiSuggestedDecision @default(NEEDS_REVIEW)
  reasonCodes       String[]            @default([])
  ocrTier           String?
  costCents         Float               @default(0)
  cacheHit          Boolean             @default(false)
  autoApproved      Boolean             @default(false)
  modelVersion      String?
  errorMessage      String?
  createdAt         DateTime            @default(now())

  documentItem   CaseDocumentItem        @relation(fields: [documentItemId], references: [id])
  version        ClientDocumentVersion   @relation(fields: [versionId], references: [id])
  reviewDecision DocumentReviewDecision?

  @@index([documentItemId])
  @@index([versionId])
  @@index([caseId])
  @@map("document_ai_assessments")
  @@schema("processing")
}

// Phase E — multi-channel document intake. A document that arrived OUTSIDE a
// specific checklist slot (client sent it on WhatsApp / email / portal) and is
// awaiting triage: the AI classifies it and suggests which CaseDocumentItem it
// satisfies; an associate files it into a slot (creating a ClientDocumentVersion)
// or discards it. suggestedItemId / filedItemId / filedByUserId are plain
// references (no FK) to keep this decoupled.
model InboundDocument {
  id                 String                @id @default(uuid())
  caseId             String
  source             InboundDocumentSource
  storageKey         String
  fileName           String
  mimeType           String?
  fileSizeBytes      Int?
  whatsappMessageId  String?
  detectedDocType    String?
  classifyConfidence Float?
  suggestedItemId    String?
  status             InboundDocumentStatus @default(PENDING)
  filedItemId        String?
  filedVersionId     String?
  filedByUserId      String?
  triagedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  case ProcessingCase @relation(fields: [caseId], references: [id])

  @@index([caseId, status])
  @@map("inbound_documents")
  @@schema("processing")
}

model DocumentAccessLog {
  id                String        @id @default(uuid())
  documentVersionId String
  accessedByUserId  String
  accessType        DocAccessType
  ipAddress         String?
  userAgent         String?
  signedUrlIssuedAt DateTime      @default(now())
  createdAt         DateTime      @default(now())

  documentVersion ClientDocumentVersion @relation(fields: [documentVersionId], references: [id])
  accessedBy      UserAccount           @relation("DocAccessedBy", fields: [accessedByUserId], references: [id])

  @@index([documentVersionId])
  @@index([accessedByUserId])
  @@map("document_access_logs")
  @@schema("processing")
}

model CorrectionRequest {
  id                String                   @id @default(uuid())
  caseId            String
  documentItemId    String?
  raisedByOfficerId String
  correctionType    CorrectionType
  subject           String
  reasonCodes       String[]
  officerNote       String?
  clientMessage     String
  requiredAction    CorrectionRequiredAction
  slaHours          Int                      @default(120)
  slaDueAt          DateTime?
  status            CorrectionStatus         @default(SENT)
  resolvedAt        DateTime?
  resolvedByUserId  String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  case         ProcessingCase    @relation(fields: [caseId], references: [id])
  documentItem CaseDocumentItem? @relation(fields: [documentItemId], references: [id])
  raisedBy     UserAccount       @relation("CorrectionRaisedBy", fields: [raisedByOfficerId], references: [id])
  resolvedBy   UserAccount?      @relation("CorrectionResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([caseId])
  @@index([status])
  @@map("correction_requests")
  @@schema("processing")
}

model CaseCommunication {
  id                String                   @id @default(uuid())
  caseId            String
  direction         CommunicationDirection
  messageType       CommunicationMessageType
  subject           String?
  content           String
  channelsSent      String[]
  sentByUserId      String?
  readByClientAt    DateTime?
  whatsappMessageId String?
  emailMessageId    String?
  createdAt         DateTime                 @default(now())

  case   ProcessingCase @relation(fields: [caseId], references: [id])
  sentBy UserAccount?   @relation("CaseCommunicationSentBy", fields: [sentByUserId], references: [id])

  @@index([caseId, createdAt(sort: Desc)])
  @@map("case_communications")
  @@schema("processing")
}

model ClientReminder {
  id              String                 @id @default(uuid())
  caseId          String
  clientId        String?
  reminderType    ReminderType
  channel         ReminderChannel
  scheduledAt     DateTime
  sentAt          DateTime?
  deliveryStatus  ReminderDeliveryStatus @default(PENDING)
  templateId      String?
  renderedContent String?
  retryCount      Int                    @default(0)
  errorMessage    String?
  createdAt       DateTime               @default(now())

  case   ProcessingCase @relation(fields: [caseId], references: [id])
  client Client?        @relation(fields: [clientId], references: [id])

  @@index([caseId])
  @@index([scheduledAt])
  @@map("client_reminders")
  @@schema("crm")
}

model ProcessingNote {
  id              String             @id @default(uuid())
  caseId          String
  content         String
  noteType        ProcessingNoteType @default(GENERAL)
  isPinned        Boolean            @default(false)
  mentions        String[]
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  case      ProcessingCase @relation(fields: [caseId], references: [id])
  createdBy UserAccount    @relation("ProcessingNoteCreatedBy", fields: [createdByUserId], references: [id])

  @@index([caseId])
  @@map("processing_notes")
  @@schema("processing")
}

// Per-case checkable milestones — auto-populated from a per-service-type
// template at acknowledge time. Captures the granular workflow inside a
// stage (e.g. WORK_PERMIT cases see "LMIA Submission" / "Offer Letter";
// E2_VISA sees "Business Meeting" / "Incorporation"). Independent from the
// gated stage machine — managers control stage transitions; associates tick
// milestones as they complete the work.
model CaseMilestone {
  id                  String    @id @default(uuid())
  caseId              String
  title               String    @db.VarChar(200)
  description         String?
  sortOrder           Int       @default(0)
  completedAt         DateTime?
  completedByUserId   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  case        ProcessingCase @relation(fields: [caseId], references: [id])
  completedBy UserAccount?   @relation("CaseMilestoneCompletedBy", fields: [completedByUserId], references: [id])

  @@index([caseId, sortOrder])
  @@map("case_milestones")
