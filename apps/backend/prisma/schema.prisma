  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  PERMISSION_CHANGED
  USER_ROLE_ASSIGNED
  USER_ROLE_REMOVED
