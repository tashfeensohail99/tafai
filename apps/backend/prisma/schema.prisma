}

model ProcessingTask {
  id                String               @id @default(uuid())
  caseId            String
  title             String               @db.VarChar(120)
  description       String?
  assignedToUserId  String?
  createdByUserId   String
  dueDate           DateTime?            @db.Date
  priority          ProcessingTaskPriority @default(NORMAL)
  status            ProcessingTaskStatus @default(OPEN)
  completedAt       DateTime?
  completedByUserId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  case        ProcessingCase @relation(fields: [caseId], references: [id])
  assignedTo  UserAccount?   @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy   UserAccount    @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  completedBy UserAccount?   @relation("TaskCompletedBy", fields: [completedByUserId], references: [id])

  @@index([caseId])
  @@index([assignedToUserId, status])
  @@map("processing_tasks")
  @@schema("processing")
}

model AuthoritySubmission {
  id                  String                    @id @default(uuid())
  caseId              String
  submissionNumber    Int
  submittedByUserId   String
  submissionDate      DateTime                  @db.Date
  submissionReference String?
  authority           String
  documentsIncluded   String[]
  trackingNumber      String?
  status              AuthoritySubmissionStatus @default(SUBMITTED)
  responseReceivedAt  DateTime?
  responseType        AuthorityResponseType?
  responseNotes       String?
  nextAction          String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  case        ProcessingCase @relation(fields: [caseId], references: [id])
  submittedBy UserAccount    @relation("AuthoritySubmittedBy", fields: [submittedByUserId], references: [id])

  @@index([caseId])
  @@map("authority_submissions")
  @@schema("processing")
}

model ProcessingAuditLog {
  id          String   @id @default(uuid())
  caseId      String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  case  ProcessingCase? @relation(fields: [caseId], references: [id])
