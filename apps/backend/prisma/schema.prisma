// =============================================================================
// Tashfeen Immigration Solutions AI Platform
// Database Schema — Prisma
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // Modular schemas. Each top-level domain lives in its own Postgres schema
  // for clear ownership, scoped permissions, and easier future extraction.
  //   core         organization, identity, RBAC, employees, partners
  //   audit        compliance-grade tamper-evident audit trail
  //   crm          customer relationship: leads, clients, follow-ups,
  //                appointments, activity timeline, reminders
  //   processing   immigration case pipeline, documents, authority submissions
  //   finance      invoices, payments, finance handovers
  //   ai           AI document-processing jobs
  //   whatsapp     WhatsApp Business Cloud API integration
  //   sales        (reserved) commissions, quotas, sales-specific analytics
  //   client_portal (reserved) future client self-service tables
  //   public       Prisma's _prisma_migrations only
  schemas   = ["public", "core", "audit", "crm", "processing", "finance", "ai", "sales", "client_portal", "whatsapp"]
}

