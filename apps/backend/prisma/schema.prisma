// =============================================================================
// Tashfeen Immigration Solutions AI Platform
// Database Schema — Prisma
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // Modular schemas. Each top-level domain lives in its own Postgres schema
  // for clear ownership, scoped permissions, and easier future extraction.
  //   core         organization, identity, RBAC, employees, partners
  //   audit        compliance-grade tamper-evident audit trail
  //   crm          customer relationship: leads, clients, follow-ups,
  //                appointments, activity timeline, reminders
  //   processing   immigration case pipeline, documents, authority submissions
  //   finance      invoices, payments, finance handovers
  //   ai           AI document-processing jobs
  //   whatsapp     WhatsApp Business Cloud API integration
  //   sales        (reserved) commissions, quotas, sales-specific analytics
  //   client_portal (reserved) future client self-service tables
  //   public       Prisma's _prisma_migrations only
  schemas   = ["public", "core", "audit", "crm", "processing", "finance", "ai", "sales", "client_portal", "whatsapp"]
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  @@schema("core")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  @@schema("core")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  FOLLOW_UP
  CONVERTED
  LOST
  DUPLICATE
  UNQUALIFIED
  @@schema("crm")
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
  @@schema("crm")
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  @@schema("crm")
}

enum ClientStatus {
  // Pre-processing
  NEW_CLIENT
  ACTIVE
  // Mirrors ProcessingCase.stage at a coarser, client-portal-friendly level.
  // ProcessingCase.stage remains the operational source of truth; Client.status
  // is the summary value used by dashboards, admin tables, and the portal.
  DOCUMENTS_PENDING
  UNDER_PROCESSING
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
  // Lifecycle exits
  CLOSED
  CANCELLED
  REFUNDED
  // Disabled states
  BLOCKED
  INACTIVE
  @@schema("crm")
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  DOCUMENTATION
  PROCESSING
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
  COMPLETED
  ON_HOLD
  @@schema("processing")
}

enum DocumentStatus {
  PENDING
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  REPLACEMENT_REQUIRED
  @@schema("processing")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  @@schema("crm")
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
  DISPUTED
  @@schema("finance")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  @@schema("finance")
}

enum FinanceHandoverStatus {
  SUBMITTED
  IN_REVIEW
  PAYMENT_RECORDED
  PAYMENT_VERIFIED
  REJECTED
  CANCELLED
  SENT_TO_PROCESSING
  @@schema("finance")
}

enum ServiceContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  @@schema("finance")
}

enum InstallmentStatus {
  PENDING
  INVOICED
  PAID
  OVERDUE
  CANCELLED
  @@schema("finance")
}

