{
  "name": "@tashfeen/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript types, enums, and interfaces for the Tashfeen AI Platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./enums": {
      "import": "./dist/enums/index.js",
      "require": "./dist/enums/index.js",
      "types": "./dist/enums/index.d.ts"
    },
    "./entities": {
      "import": "./dist/entities/index.js",
      "require": "./dist/entities/index.js",
      "types": "./dist/entities/index.d.ts"
    },
    "./portal": {
      "import": "./dist/portal/index.js",
      "require": "./dist/portal/index.js",
      "types": "./dist/portal/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "require": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
